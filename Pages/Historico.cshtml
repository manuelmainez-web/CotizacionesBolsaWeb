@page
@model CotizacionesBolsaWeb.Pages.HistoricoModel
@{
    ViewData["Title"] = "Histórico de cotización";
    ViewData["HideRefreshButton"] = true;
    ViewData["HideTopbarBranding"] = true;
}

<div class="market-shell">
    <div class="portfolio-header historico-header">
        <div class="title-block">
            <h1 class="mb-1 name-with-flag">
                <img class="flag-badge flag-badge-title" src="@Model.FlagUrl" alt="@Model.CountryCode" title="@Model.CountryCode" />
                @Model.Name
            </h1>
            <p class="portfolio-subtitle">@Model.DisplaySymbol · Progresión de la cotización en el tiempo</p>
        </div>
        <button type="button" id="btn-print-historico" class="btn-refresh no-print" title="Imprimir">
            🖨️ Imprimir
        </button>
    </div>

    @if (Model.HasData && Model.RentabilidadPeriodos.Count > 0)
    {
        <div class="market-panel rentabilidad-panel">
            <div class="panel-head">
                <span>Rentabilidad por periodo</span>
            </div>
            <div class="rentabilidad-strip">
                @foreach (var periodo in Model.RentabilidadPeriodos)
                {
                    var esPeriodoActual = Model.RangeEtiquetasEquivalentes.Contains(periodo.Etiqueta);
                    <div class="rentabilidad-box @(esPeriodoActual ? "rentabilidad-box-current" : "")">
                        <span>@periodo.Etiqueta</span>
                        <strong class="@(periodo.Porcentaje is null ? "text-muted" : periodo.Porcentaje >= 0 ? "text-success" : "text-danger")">
                            @(periodo.Porcentaje.HasValue ? $"{periodo.Porcentaje.Value:+0.00;-0.00}%" : "N/D")
                        </strong>
                    </div>
                }
            </div>
        </div>

        <div class="market-panel recomendacion-panel">
            <div class="tech-recommendation">
                <span class="tech-recommendation-label">Recomendación técnica</span>
                <strong class="@Model.RecomendacionGlobalCss">@Model.RecomendacionGlobalTexto</strong>
            </div>
        </div>
    }

    @if (Model.HasData)
    {
        <div class="historico-tabs" role="tablist">
            <button type="button" class="historico-tab is-active" data-tab-target="tab-grafica" role="tab" aria-selected="true">Gráfica</button>
            <button type="button" class="historico-tab" data-tab-target="tab-tecnico" role="tab" aria-selected="false">Análisis técnico</button>
            <button type="button" class="historico-tab" data-tab-target="tab-fundamental" role="tab" aria-selected="false">Análisis fundamental</button>
        </div>
    }

    <div class="historico-tab-panel is-active" id="tab-grafica">
        <div class="charts-row">
            <div class="market-panel chart-panel-half">
                <div class="panel-head panel-head-row">
                    <span>Cotización histórica</span>
                    <select id="range-select" class="mini-select" aria-label="Periodo"
                            onchange="window.location.href = '/Historico?symbol=@Uri.EscapeDataString(Model.Symbol)&name=@Uri.EscapeDataString(Model.Name)&countryCode=@Uri.EscapeDataString(Model.CountryCode ?? string.Empty)&range=' + this.value;">
                        <option value="1d" selected="@(Model.Range == "1d")">Día</option>
                        <option value="5d" selected="@(Model.Range == "5d")">Semana</option>
                        <option value="1mo" selected="@(Model.Range == "1mo")">Mes</option>
                        <option value="1y" selected="@(Model.Range == "1y")">Año</option>
                        <option value="max" selected="@(Model.Range == "max")">Desde el principio</option>
                    </select>
                </div>
                <div class="chart-wrap">
                    @if (Model.HasData)
                    {
                        <canvas id="historyChart"></canvas>
                    }
                    else
                    {
                        <p class="empty-state-cell">No hay datos históricos disponibles para este valor y periodo.</p>
                    }
                </div>
            </div>

            @if (Model.HasData)
            {
                <div class="market-panel chart-panel-half">
                    <div class="panel-head panel-head-row">
                        <span>Análisis técnico</span>
                        <div class="chart-controls">
                            <select id="chart-type-select" class="mini-select" aria-label="Tipo de gráfico">
                                <option value="candlestick">Velas</option>
                                <option value="ohlc">Barras</option>
                                <option value="line">Línea</option>
                                <option value="area">Área</option>
                            </select>
                            <div class="indicator-dropdown">
                                <button type="button" class="mini-button" id="indicator-dropdown-toggle" aria-haspopup="true" aria-expanded="false">
                                    Indicadores <span class="indicator-dropdown-arrow">▾</span>
                                </button>
                                <div class="indicator-dropdown-menu" id="indicator-dropdown-menu" hidden>
                                    <label class="indicator-option">
                                        <input type="checkbox" data-indicator="sma20" checked>
                                        <span>SMA 20</span>
                                    </label>
                                    <label class="indicator-option">
                                        <input type="checkbox" data-indicator="sma50" checked>
                                        <span>SMA 50</span>
                                    </label>
                                    <label class="indicator-option">
                                        <input type="checkbox" data-indicator="volumen">
                                        <span>Volumen</span>
                                    </label>
                                    <label class="indicator-option">
                                        <input type="checkbox" data-indicator="rsi">
                                        <span>RSI (14)</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="chart-wrap">
                        <canvas id="candlestickChart"></canvas>
                    </div>
                    <div class="chart-sub" id="volume-chart-wrap" hidden>
                        <div class="chart-sub-label">Volumen</div>
                        <div class="chart-sub-canvas-wrap">
                            <canvas id="volumeChart"></canvas>
                        </div>
                    </div>
                    <div class="chart-sub" id="rsi-chart-wrap" hidden>
                        <div class="chart-sub-label">RSI (14)</div>
                        <div class="chart-sub-canvas-wrap chart-sub-canvas-wrap-rsi">
                            <canvas id="rsiChart"></canvas>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (Model.HasData)
    {
        <div class="historico-tab-panel" id="tab-tecnico" hidden>
            <div class="market-panel">
                <div class="summary-strip summary-strip-wide">
                    <div class="summary-box">
                        <span>Señal medias móviles</span>
                        <strong class="@Model.SenalMediasMovilesCss">@Model.SenalMediasMovilesTexto</strong>
                    </div>
                    <div class="summary-box">
                        <span>Señal osciladores</span>
                        <strong class="@Model.SenalOsciladoresCss">@Model.SenalOsciladoresTexto</strong>
                    </div>
                    <div class="summary-box">
                        <span>Tendencia (SMA 20/50)</span>
                        <strong class="@Model.TendenciaCss">@Model.TendenciaTexto</strong>
                    </div>
                    <div class="summary-box">
                        <span>Tendencia largo plazo (SMA 200)</span>
                        <strong class="@Model.TendenciaLargoPlazoCss">@Model.TendenciaLargoPlazoTexto</strong>
                    </div>
                    <div class="summary-box">
                        <span>RSI (14)</span>
                        <strong class="@Model.RsiCss">@Model.RsiTexto</strong>
                    </div>
                    <div class="summary-box">
                        <span>MACD (12,26,9)</span>
                        <strong class="@Model.MacdCss">@Model.MacdTexto</strong>
                    </div>
                    <div class="summary-box">
                        <span>Estocástico (14,3)</span>
                        <strong class="@Model.EstocasticoCss">@Model.EstocasticoTexto</strong>
                    </div>
                    <div class="summary-box">
                        <span>Williams %R (14)</span>
                        <strong class="@Model.WilliamsRCss">@Model.WilliamsRTexto</strong>
                    </div>
                    <div class="summary-box">
                        <span>Bandas de Bollinger (20,2)</span>
                        <strong>@Model.BollingerTexto</strong>
                    </div>
                    <div class="summary-box">
                        <span>Momentum / ROC (10)</span>
                        <strong class="@Model.MomentumCss">@Model.MomentumTexto</strong>
                    </div>
                    <div class="summary-box">
                        <span>ATR (14) · Volatilidad</span>
                        <strong>@Model.AtrTexto</strong>
                    </div>
                    <div class="summary-box">
                        <span>Volumen actual vs. medio</span>
                        <strong class="@Model.VolumenRelativoCss">@Model.VolumenRelativoTexto</strong>
                    </div>
                    <div class="summary-box">
                        <span>Soporte / Resistencia recientes</span>
                        <strong>@Model.SoporteResistenciaTexto</strong>
                    </div>
                    <div class="summary-box">
                        <span>Variación del periodo</span>
                        <strong class="@(Model.VariacionPeriodoPct is >= 0 ? "text-success" : "text-danger")">@(Model.VariacionPeriodoPct.HasValue ? $"{Model.VariacionPeriodoPct.Value:+0.00;-0.00}%" : "N/D")</strong>
                    </div>
                    <div class="summary-box">
                        <span>Máximo / Mínimo del periodo</span>
                        <strong>@(Model.PeriodoMax.HasValue ? Model.PeriodoMax.Value.ToString("#,##0.00") : "N/D") / @(Model.PeriodoMin.HasValue ? Model.PeriodoMin.Value.ToString("#,##0.00") : "N/D")</strong>
                    </div>
                    <div class="summary-box">
                        <span>SMA 20 / SMA 50 / SMA 200</span>
                        <strong>@(Model.LastSma20.HasValue ? Model.LastSma20.Value.ToString("#,##0.00") : "N/D") / @(Model.LastSma50.HasValue ? Model.LastSma50.Value.ToString("#,##0.00") : "N/D") / @(Model.LastSma200.HasValue ? Model.LastSma200.Value.ToString("#,##0.00") : "N/D")</strong>
                    </div>
                </div>
                <p class="fundamental-note">Indicadores calculados a partir de los propios datos históricos del periodo seleccionado (@Model.Range). Amplía el rango (Año / Desde el principio) para obtener SMA 200, MACD y Bollinger más fiables.</p>
            </div>
        </div>

        <div class="historico-tab-panel" id="tab-fundamental" hidden>
            <div class="market-panel">
                @if (Model.HasFundamentalData)
                {
                    <div class="summary-strip summary-strip-wide">
                        @if (!string.IsNullOrWhiteSpace(Model.MarketCap))
                        {
                            <div class="summary-box">
                                <span>Capitalización</span>
                                <strong>@Model.MarketCap</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.PeRatio))
                        {
                            <div class="summary-box">
                                <span>PER (histórico)</span>
                                <strong>@Model.PeRatio</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ForwardPe))
                        {
                            <div class="summary-box">
                                <span>PER (futuro)</span>
                                <strong>@Model.ForwardPe</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Eps))
                        {
                            <div class="summary-box">
                                <span>BPA (EPS)</span>
                                <strong>@Model.Eps</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.DividendInfo))
                        {
                            <div class="summary-box">
                                <span>Dividendo / Rentabilidad</span>
                                <strong>@Model.DividendInfo</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ExDividendDate))
                        {
                            <div class="summary-box">
                                <span>Fecha ex-dividendo</span>
                                <strong>@Model.ExDividendDate</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Revenue))
                        {
                            <div class="summary-box">
                                <span>Ingresos (ttm)</span>
                                <strong>@Model.Revenue</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.NetIncome))
                        {
                            <div class="summary-box">
                                <span>Beneficio neto (ttm)</span>
                                <strong>@Model.NetIncome</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SharesOutstanding))
                        {
                            <div class="summary-box">
                                <span>Acciones en circulación</span>
                                <strong>@Model.SharesOutstanding</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Beta))
                        {
                            <div class="summary-box">
                                <span>Beta</span>
                                <strong>@Model.Beta</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.PriceTarget))
                        {
                            <div class="summary-box">
                                <span>Precio objetivo (analistas)</span>
                                <strong>@Model.PriceTarget</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Sector))
                        {
                            <div class="summary-box">
                                <span>Sector</span>
                                <strong>@Model.Sector</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Employees))
                        {
                            <div class="summary-box">
                                <span>Empleados</span>
                                <strong>@Model.Employees</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.IpoDate))
                        {
                            <div class="summary-box">
                                <span>Fecha de salida a bolsa</span>
                                <strong>@Model.IpoDate</strong>
                            </div>
                        }
                        <div class="summary-box">
                            <span>Rango 52 semanas</span>
                            <strong>@(Model.FiftyTwoWeekLow.HasValue ? Model.FiftyTwoWeekLow.Value.ToString("#,##0.00") : "N/D") - @(Model.FiftyTwoWeekHigh.HasValue ? Model.FiftyTwoWeekHigh.Value.ToString("#,##0.00") : "N/D")</strong>
                        </div>
                        <div class="summary-box">
                            <span>Mercado / Bolsa</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Exchange) ? "N/D" : Model.Exchange)</strong>
                        </div>
                        <div class="summary-box">
                            <span>Divisa</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Currency) ? "N/D" : Model.Currency)</strong>
                        </div>
                        <div class="summary-box">
                            <span>Tipo de instrumento</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.InstrumentTypeTexto) ? "N/D" : Model.InstrumentTypeTexto)</strong>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.FundamentalSourceNote))
                    {
                        <p class="fundamental-note">@Model.FundamentalSourceNote</p>
                    }
                }
                else
                {
                    <p class="empty-state-cell">No hay datos fundamentales disponibles para este valor.</p>
                }
            </div>
        </div>
    }
</div>

<script>
    (function () {
        var boton = document.getElementById('btn-print-historico');
        if (!boton) {
            return;
        }

        boton.addEventListener('click', function () {
            window.print();
        });
    })();
</script>

@if (Model.HasData)
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-chart-financial@0.2.1/dist/chartjs-chart-financial.min.js"></script>
    <script>
        const labels = @Html.Raw(Model.LabelsJson);
        const values = @Html.Raw(Model.ValuesJson);
        const opens = @Html.Raw(Model.OpenJson);
        const highs = @Html.Raw(Model.HighJson);
        const lows = @Html.Raw(Model.LowJson);
        const closes = @Html.Raw(Model.CloseJson);
        const volumes = @Html.Raw(Model.VolumeJson);
        const sma20 = @Html.Raw(Model.Sma20Json);
        const sma50 = @Html.Raw(Model.Sma50Json);
        const rsi = @Html.Raw(Model.RsiJson);

        const ctx = document.getElementById('historyChart');
        const graficoHistorico = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: '@Model.Symbol',
                    data: values,
                    borderColor: '#60a5fa',
                    backgroundColor: 'rgba(96, 165, 250, 0.15)',
                    fill: true,
                    tension: 0.2,
                    pointRadius: 0,
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: { ticks: { color: '#a9bacd', maxTicksLimit: 12 }, grid: { color: 'rgba(148,163,184,0.08)' } },
                    y: { ticks: { color: '#a9bacd' }, grid: { color: 'rgba(148,163,184,0.08)' } }
                }
            }
        });

        function etiquetaEnIndice(value) {
            return labels[value] !== undefined ? labels[value] : '';
        }

        const ejeXComun = {
            type: 'linear',
            ticks: { color: '#a9bacd', maxTicksLimit: 12, callback: etiquetaEnIndice },
            grid: { color: 'rgba(148,163,184,0.08)' }
        };

        // Gráfico técnico: velas / barras OHLC / línea / área (seleccionable desde un desplegable)
        const candleData = closes.map(function (c, i) {
            return { x: i, o: opens[i], h: highs[i], l: lows[i], c: c };
        });
        const smaData20 = sma20.map(function (v, i) { return { x: i, y: v }; });
        const smaData50 = sma50.map(function (v, i) { return { x: i, y: v }; });

        const selectorTipo = document.getElementById('chart-type-select');
        const checkboxSma20 = document.querySelector('[data-indicator="sma20"]');
        const checkboxSma50 = document.querySelector('[data-indicator="sma50"]');
        const checkboxVolumen = document.querySelector('[data-indicator="volumen"]');
        const checkboxRsi = document.querySelector('[data-indicator="rsi"]');

        let graficoTecnico = null;
        let graficoVolumen = null;
        let graficoRsi = null;

        function crearGraficoTecnico(tipo) {
            if (graficoTecnico) {
                graficoTecnico.destroy();
            }

            const datasets = [];
            let datasetPrecio;
            let tipoGrafico;

            if (tipo === 'ohlc') {
                tipoGrafico = 'ohlc';
                datasetPrecio = {
                    label: 'Precio',
                    data: candleData,
                    color: { up: '#22c55e', down: '#ef4444', unchanged: '#a9bacd' }
                };
            } else if (tipo === 'line' || tipo === 'area') {
                tipoGrafico = 'line';
                datasetPrecio = {
                    label: 'Precio',
                    data: closes.map(function (c, i) { return { x: i, y: c }; }),
                    borderColor: '#60a5fa',
                    backgroundColor: 'rgba(96, 165, 250, 0.15)',
                    fill: tipo === 'area',
                    tension: 0.15,
                    pointRadius: 0,
                    borderWidth: 2
                };
            } else {
                tipoGrafico = 'candlestick';
                datasetPrecio = {
                    label: 'Precio',
                    data: candleData,
                    color: { up: '#22c55e', down: '#ef4444', unchanged: '#a9bacd' }
                };
            }

            datasets.push(datasetPrecio);

            if (checkboxSma20.checked) {
                datasets.push({
                    type: 'line',
                    label: 'SMA 20',
                    data: smaData20,
                    borderColor: '#facc15',
                    borderWidth: 1.5,
                    pointRadius: 0,
                    spanGaps: true
                });
            }

            if (checkboxSma50.checked) {
                datasets.push({
                    type: 'line',
                    label: 'SMA 50',
                    data: smaData50,
                    borderColor: '#a78bfa',
                    borderWidth: 1.5,
                    pointRadius: 0,
                    spanGaps: true
                });
            }

            graficoTecnico = new Chart(document.getElementById('candlestickChart'), {
                type: tipoGrafico,
                data: { datasets: datasets },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: true,
                            labels: { color: '#a9bacd', filter: function (item) { return item.text !== 'Precio'; } }
                        }
                    },
                    scales: {
                        x: ejeXComun,
                        y: { ticks: { color: '#a9bacd' }, grid: { color: 'rgba(148,163,184,0.08)' } }
                    }
                }
            });
        }

        function actualizarGraficoTecnico() {
            crearGraficoTecnico(selectorTipo.value);
        }

        actualizarGraficoTecnico();
        selectorTipo.addEventListener('change', actualizarGraficoTecnico);
        checkboxSma20.addEventListener('change', actualizarGraficoTecnico);
        checkboxSma50.addEventListener('change', actualizarGraficoTecnico);

        // Volumen (barras verdes/rojas según si la sesión cerró en subida o bajada) - solo si se marca en Indicadores
        function crearGraficoVolumen() {
            const volumeColors = closes.map(function (c, i) {
                const previo = i > 0 ? closes[i - 1] : opens[i];
                return c >= previo ? 'rgba(34, 197, 94, 0.55)' : 'rgba(239, 68, 68, 0.55)';
            });

            graficoVolumen = new Chart(document.getElementById('volumeChart'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Volumen',
                        data: volumes,
                        backgroundColor: volumeColors,
                        barPercentage: 1,
                        categoryPercentage: 0.9
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { ticks: { color: '#a9bacd', maxTicksLimit: 8, callback: etiquetaEnIndice }, grid: { display: false } },
                        y: { ticks: { color: '#a9bacd', maxTicksLimit: 4 }, grid: { color: 'rgba(148,163,184,0.08)' } }
                    }
                }
            });
        }

        // RSI (14) con zonas de sobrecompra (70) / sobreventa (30) - solo si se marca en Indicadores
        function crearGraficoRsi() {
            graficoRsi = new Chart(document.getElementById('rsiChart'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'RSI (14)',
                            data: rsi,
                            borderColor: '#38bdf8',
                            borderWidth: 1.5,
                            pointRadius: 0,
                            spanGaps: true
                        },
                        {
                            label: 'Sobrecompra (70)',
                            data: labels.map(function () { return 70; }),
                            borderColor: 'rgba(239, 68, 68, 0.55)',
                            borderWidth: 1,
                            borderDash: [4, 4],
                            pointRadius: 0
                        },
                        {
                            label: 'Sobreventa (30)',
                            data: labels.map(function () { return 30; }),
                            borderColor: 'rgba(34, 197, 94, 0.55)',
                            borderWidth: 1,
                            borderDash: [4, 4],
                            pointRadius: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            labels: { color: '#a9bacd', boxWidth: 12, filter: function (item) { return item.text === 'RSI (14)'; } }
                        }
                    },
                    scales: {
                        x: { ticks: { color: '#a9bacd', maxTicksLimit: 8, callback: etiquetaEnIndice }, grid: { display: false } },
                        y: { min: 0, max: 100, ticks: { color: '#a9bacd', stepSize: 25 }, grid: { color: 'rgba(148,163,184,0.08)' } }
                    }
                }
            });
        }

        checkboxVolumen.addEventListener('change', function () {
            const contenedor = document.getElementById('volume-chart-wrap');
            if (checkboxVolumen.checked) {
                contenedor.hidden = false;
                crearGraficoVolumen();
            } else {
                contenedor.hidden = true;
                if (graficoVolumen) {
                    graficoVolumen.destroy();
                    graficoVolumen = null;
                }
            }
        });

        checkboxRsi.addEventListener('change', function () {
            const contenedor = document.getElementById('rsi-chart-wrap');
            if (checkboxRsi.checked) {
                contenedor.hidden = false;
                crearGraficoRsi();
            } else {
                contenedor.hidden = true;
                if (graficoRsi) {
                    graficoRsi.destroy();
                    graficoRsi = null;
                }
            }
        });

        // Desplegable "Indicadores" (abrir/cerrar y cierre al pulsar fuera)
        const toggleIndicadores = document.getElementById('indicator-dropdown-toggle');
        const menuIndicadores = document.getElementById('indicator-dropdown-menu');

        toggleIndicadores.addEventListener('click', function (event) {
            event.stopPropagation();
            const estaAbierto = !menuIndicadores.hidden;
            menuIndicadores.hidden = estaAbierto;
            toggleIndicadores.setAttribute('aria-expanded', String(!estaAbierto));
        });

        menuIndicadores.addEventListener('click', function (event) {
            event.stopPropagation();
        });

        document.addEventListener('click', function () {
            menuIndicadores.hidden = true;
            toggleIndicadores.setAttribute('aria-expanded', 'false');
        });

        // Pestañas Gráfica / Análisis técnico / Análisis fundamental
        document.querySelectorAll('.historico-tab').forEach(function (boton) {
            boton.addEventListener('click', function () {
                document.querySelectorAll('.historico-tab').forEach(function (b) {
                    b.classList.remove('is-active');
                    b.setAttribute('aria-selected', 'false');
                });
                document.querySelectorAll('.historico-tab-panel').forEach(function (panel) {
                    panel.hidden = true;
                    panel.classList.remove('is-active');
                });

                boton.classList.add('is-active');
                boton.setAttribute('aria-selected', 'true');

                const destino = document.getElementById(boton.getAttribute('data-tab-target'));
                if (destino) {
                    destino.hidden = false;
                    destino.classList.add('is-active');
                }
            });
        });

        // Al imprimir, todas las pestañas se muestran a la vez (ver CSS @@media print), pero Chart.js
        // solo dibuja los canvas con el tamaño correcto si se les fuerza un resize() justo antes de
        // imprimir (si no, algunos navegadores los dejan colapsados a 0px de alto en el papel).
        window.addEventListener('beforeprint', function () {
            [graficoHistorico, graficoTecnico, graficoVolumen, graficoRsi].forEach(function (grafico) {
                if (grafico) {
                    grafico.resize();
                }
            });
        });

        window.addEventListener('afterprint', function () {
            [graficoHistorico, graficoTecnico, graficoVolumen, graficoRsi].forEach(function (grafico) {
                if (grafico) {
                    grafico.resize();
                }
            });
        });
    </script>
}
