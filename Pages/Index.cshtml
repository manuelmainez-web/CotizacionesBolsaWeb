            <div class="form-error-banner">@Model.PensionPlanError</div>
        }
        <div class="table-wrap is-collapsed">
            <table class="market-table market-table-grid market-table-cartera market-table-planes-cartera" style="table-layout: fixed;">
                <thead>
                    <tr>
                        <th class="col-nombre-cartera" style="width: 285px;">Nombre</th>
                        <th class="text-align-right col-participaciones" style="width: 110px; white-space: nowrap;">Participaciones /<br />Valor liquidativo</th>
                        <th class="text-align-right col-capital-invertido" style="width: 110px;">Capital invertido</th>
                        <th class="text-align-right col-rent-mes" style="width: 90px;">Rentabilidad<br />último mes</th>
                        <th class="text-align-right col-rent-12m" style="width: 90px;">Rentabilidad<br />12 meses</th>
                        <th class="text-align-right col-valoracion-actual" style="width: 87px;">Valoración actual</th>
                        <th class="text-align-right col-rent-inicio" style="width: 115px;">Rentabilidad<br />desde inicio</th>
                        <th class="col-codigo-dgsfp" style="width: 128px; white-space: nowrap;">Código DGSFP</th>
                        <th class="broker-header" style="width: 68px;">Bróker</th>
                        <th class="text-align-right col-actualizacion" style="width: 100px;">Actualización</th>
                        <th style="width: 65px;"></th>
                    </tr>
                </thead>
                <tbody id="tbody-pensionplans">
                    @if (Model.PensionPlans.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="empty-state-cell">No hay planes de pensiones añadidos. Usa "+ Añadir Plan" para empezar.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.PensionPlans)
                        {
                            var saldoTotal = item.Participaciones * item.ValorLiquidativo;
                            var gananciaDesdeInicio = saldoTotal - item.CapitalInvertido;
                            var rentabilidadDesdeInicio = item.CapitalInvertido > 0 ? (saldoTotal - item.CapitalInvertido) / item.CapitalInvertido * 100m : 0m;
                            var isIngDirect = item.Broker == "ING";
                            var isTradeRepublic = item.Broker == "TR";
                            var isOccident = item.Broker == "OCCIDENT";

                            <tr data-broker="@(item.Broker ?? "")">
                                <td class="name-cell col-nombre-cartera">
                                    <span class="name-with-flag">
                                        <img class="flag-badge" src="@item.FlagUrl" alt="@item.CountryCode" title="@item.CountryCode" />
                                        @item.Name
                                    </span>
                                </td>
                                <td class="purchase-cell col-participaciones">
