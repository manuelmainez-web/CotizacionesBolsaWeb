    <div class="market-panel mt-4">
        <div class="panel-head panel-head-row">
            <span>Planes de pensiones <span class="panel-head-subtitle">(Cartera)</span></span>
            <button type="button" class="mini-button" data-dialog-target="add-pensionplan-dialog">+ Añadir Plan</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.PensionPlanError))
        {
            <div class="form-error-banner">@Model.PensionPlanError</div>
        }
        <div class="table-wrap">
            <table class="market-table market-table-grid market-table-cartera market-table-planes-cartera" style="table-layout: fixed;">
                <thead>
                    <tr>
                        <th class="col-nombre-cartera" style="width: 285px;">Nombre</th>
                        <th class="text-align-right col-participaciones" style="width: 110px; white-space: nowrap;">Participaciones /<br />Valor liquidativo</th>
                        <th class="text-align-right col-capital-invertido" style="width: 110px;">Capital invertido</th>
                        <th class="text-align-right col-rent-mes" style="width: 90px;">Rentabilidad<br />último mes</th>
                        <th class="text-align-right col-rent-12m" style="width: 90px;">Rentabilidad<br />12 meses</th>
                        <th class="text-align-right col-valoracion-actual" style="width: 87px;">Valoración actual</th>
                        <th class="text-align-right col-rent-inicio" style="width: 115px;">Rentabilidad<br />desde inicio</th>
                        <th class="col-codigo-dgsfp" style="width: 128px; white-space: nowrap;">Código DGSFP</th>
                        <th class="broker-header" style="width: 68px;">Bróker</th>
                        <th class="text-align-right col-actualizacion" style="width: 100px;">Actualización</th>
                        <th style="width: 65px;"></th>
                    </tr>
                </thead>
                <tbody id="tbody-pensionplans">
                    @if (Model.PensionPlans.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="empty-state-cell">No hay planes de pensiones añadidos. Usa "+ Añadir Plan" para empezar.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.PensionPlans)
                        {
                            var saldoTotal = item.Participaciones * item.ValorLiquidativo;
                            var gananciaDesdeInicio = saldoTotal - item.CapitalInvertido;
                            var rentabilidadDesdeInicio = item.CapitalInvertido > 0 ? (saldoTotal - item.CapitalInvertido) / item.CapitalInvertido * 100m : 0m;
                            var isIngDirect = item.Broker == "ING";
                            var isTradeRepublic = item.Broker == "TR";
                            var isOccident = item.Broker == "OCCIDENT";

                            <tr data-broker="@(item.Broker ?? "")">
                                <td class="name-cell col-nombre-cartera">
                                    <span class="name-with-flag">
                                        <img class="flag-badge" src="@item.FlagUrl" alt="@item.CountryCode" title="@item.CountryCode" />
                                        @item.Name
                                    </span>
                                </td>
                                <td class="purchase-cell col-participaciones">
                                    @item.Participaciones.ToString("#,##0.######")<br />
                                    @item.ValorLiquidativo.ToString("#,##0.00 €")
                                </td>
                                <td class="price-cell price-cell-quote col-capital-invertido">@item.CapitalInvertido.ToString("#,##0.00 €")</td>
                                <td class="@((item.RentabilidadUltimoMes >= 0 ? "text-success" : "text-danger")) col-rent-mes">@item.RentabilidadUltimoMes.ToString("+#,##0.00;-#,##0.00;0.00")% @(item.RentabilidadUltimoMes >= 0 ? "▲" : "▼")</td>
                                <td class="@((item.Rentabilidad12Meses >= 0 ? "text-success" : "text-danger")) col-rent-12m">@item.Rentabilidad12Meses.ToString("+#,##0.00;-#,##0.00;0.00")% @(item.Rentabilidad12Meses >= 0 ? "▲" : "▼")</td>
                                <td class="price-cell price-cell-quote col-valoracion-actual">@saldoTotal.ToString("#,##0.00 €")</td>
                                <td class="@((rentabilidadDesdeInicio >= 0 ? "text-success" : "text-danger")) col-rent-inicio">@rentabilidadDesdeInicio.ToString("+#,##0.00;-#,##0.00;0.00")% @(rentabilidadDesdeInicio >= 0 ? "▲" : "▼")<br />@gananciaDesdeInicio.ToString("+#,##0.00 €;-#,##0.00 €;0.00 €")</td>
                                <td class="isin-cell col-codigo-dgsfp" style="white-space: nowrap;">@item.CodigoDgsfp</td>
                                <td class="broker-cell">
                                    @if (isIngDirect)
                                    {
                                        <img class="broker-logo" src="/images/brokers/ing.png" alt="ING Direct" title="ING Direct" />
                                    }
                                    else if (isTradeRepublic)
                                    {
                                        <img class="broker-logo" src="/images/brokers/traderepublic.png" alt="Trade Republic" title="Trade Republic" />
                                    }
                                    else if (isOccident)
                                    {
                                        <img class="broker-logo" src="/images/brokers/occident.png" alt="Occident" title="Occident" />
                                    }
                                </td>
                                <td class="time-cell col-actualizacion">@DateTime.Now.ToString("dd/MM/yyyy")<br />@DateTime.Now.ToString("HH:mm")</td>
                                <td class="delete-cell">
                                    <button type="button" class="icon-button-edit" data-dialog-target="edit-pensionplan-@Model.PensionPlans.IndexOf(item)" title="Editar">✎</button>
                                    <form method="post" asp-page-handler="DeletePensionPlan" onsubmit="return confirm('¿Eliminar este plan de pensiones?');">
                                        <input type="hidden" name="name" value="@item.Name" />
                                        <button type="submit" class="icon-button-delete" title="Eliminar">✕</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
            </div>
        </div>
    </div>

