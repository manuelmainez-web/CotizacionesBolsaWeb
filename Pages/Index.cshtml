        </div>
        <div class="table-wrap is-collapsed">
            <table class="market-table market-table-grid market-table-cartera market-table-etf-cartera" style="table-layout: fixed;">
                <thead>
                    <tr>
                        <th class="col-nombre-cartera" style="width: 220px;">Nombre</th>
                        <th class="text-align-right col-cambio" style="width: 55px;">Cambio</th>
                        <th class="text-align-right notranslate col-cotizacion" translate="no" style="width: 65px;">COTIZACIÓN ACTUAL</th>
                        <th class="text-align-right col-valoracion-actual" style="width: 70px;">Valoración actual</th>
                        <th class="text-align-right col-rent-importe" style="width: 75px;">Rentabilidad /<br />Importe</th>
                        <th class="text-align-right col-titulos-compra" style="width: 80px;">TITULOS /PRECIO COMPRA</th>
                        <th class="text-align-right col-valoracion-compra" style="width: 90px;">Valoración compra</th>
                        <th class="isin-print-hide text-align-right" style="width: 90px;">ISIN</th>
                        <th class="broker-header" style="width: 50px;">Bróker</th>
                        <th class="text-align-right col-actualizacion" style="width: 96px;">Actualización</th>
                        <th style="width: 52px;"></th>
                    </tr>
                </thead>
                <tbody id="tbody-etfs">
                    @if (Model.Etfs.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="empty-state-cell">No hay ETF añadidos. Usa "+ Añadir ETF" para empezar.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Etfs.OrderBy(e => Model.EtfHoldings.FirstOrDefault(h => h.Symbol == e.Symbol)?.Broker == "ING" ? 0 : 1))
                        {
                            var holding = Model.EtfHoldings.FirstOrDefault(h => h.Symbol == item.Symbol);
                            var currentPrice = item.Price ?? 0m;
                            var positionCount = holding?.PositionCount ?? 0m;
                            var purchaseDisplayValue = holding?.UnitPurchasePrice ?? 0m;
                            var purchaseValue = positionCount * purchaseDisplayValue;
                            var currentValue = currentPrice * positionCount;
                            var gainValue = currentValue - purchaseValue;
                            var gainPercent = purchaseValue == 0 ? 0m : (gainValue / purchaseValue) * 100m;
                            var isIngDirect = holding?.Broker == "ING";
                            var isTradeRepublic = holding?.Broker == "TR";

                            <tr class="@(item.Symbol == "UST.PA" ? "row-divider-bottom" : "")" data-broker="@(holding?.Broker ?? "")">
                                <td class="name-cell name-cell-regular col-nombre-cartera">
                                    <span class="name-with-flag">
                                        <img class="flag-badge" src="@item.FlagUrl" alt="@item.CountryCode" title="@item.CountryCode" />
                                        <a class="name-link" href="/Historico?symbol=@item.Symbol&name=@item.Name&countryCode=@item.CountryCode">@item.Name</a>
                                    </span>
                                </td>
                                <td class="@item.TrendCssClass col-cambio">@item.DisplayPercent</td>
                                <td class="price-cell price-cell-quote col-cotizacion">@currentPrice.ToString("#,##0.00 €")</td>
                                <td class="price-cell price-cell-quote col-valoracion-actual">@currentValue.ToString("#,##0.00 €")</td>
                                <td class="@((gainPercent >= 0 ? "text-success" : "text-danger")) col-rent-importe">@gainPercent.ToString("+#,##0.00;-#,##0.00;0.00")% @(gainPercent >= 0 ? "▲" : "▼")<br />@gainValue.ToString("+#,##0.00 €;-#,##0.00 €;0.00 €")</td>
                                <td class="purchase-cell">
                                    @positionCount.ToString("#,##0.######")<br />
                                    @purchaseDisplayValue.ToString("#,##0.00 €")
                                </td>
                                <td class="price-cell price-cell-quote col-valoracion-compra">@purchaseValue.ToString("#,##0.00 €")</td>
                                <td class="isin-cell isin-print-hide">@item.DisplayIsin</td>
                                <td class="broker-cell">
                                    @if (isIngDirect)
                                    {
                                        <img class="broker-logo" src="/images/brokers/ing.png" alt="ING Direct" title="ING Direct" />
                                    }
                                    else if (isTradeRepublic)
                                    {
                                        <img class="broker-logo" src="/images/brokers/traderepublic.png" alt="Trade Republic" title="Trade Republic" />
                                    }
                                </td>
                                <td class="time-cell time-cell-compact">
                                    @item.UpdatedText
                                    <span class="market-clock @(item.IsMarketOpen ? "market-open" : "market-closed")" title="@item.MarketStatusLabel" aria-label="@item.MarketStatusLabel">
                                        <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true" focusable="false">
                                            <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                                            <path d="M8 4.3v4l2.6 2.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                </td>
                                <td class="delete-cell">
                                    <button type="button" class="icon-button-edit" data-dialog-target="edit-etf-@item.Symbol" title="Editar">✎</button>
                                    <form method="post" asp-page-handler="DeleteEtf" onsubmit="return confirm('¿Eliminar este ETF?');">
                                        <input type="hidden" name="symbol" value="@item.Symbol" />
                                        <button type="submit" class="icon-button-delete" title="Eliminar">✕</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @foreach (var item in Model.Etfs)
    {
        var etfHolding = Model.EtfHoldings.FirstOrDefault(h => h.Symbol == item.Symbol);
        var etfPositionCount = etfHolding?.PositionCount ?? 0m;
        var etfPurchaseDisplayValue = etfHolding?.UnitPurchasePrice ?? 0m;
        var etfIsIngDirect = etfHolding?.Broker == "ING";
        var etfIsTradeRepublic = etfHolding?.Broker == "TR";

        <dialog id="edit-etf-@item.Symbol" class="add-entry-dialog">
            <form method="post" asp-page-handler="EditEtf">
                <h3>Editar @item.Name</h3>
                <input type="hidden" name="symbol" value="@item.Symbol" />
