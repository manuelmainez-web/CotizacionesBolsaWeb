    <div class="market-panel hacienda-panel mt-4">
        <div class="panel-head panel-head-row">
            <span>
                <button type="button" class="btn-toggle-summary table-toggle-button toggle-left" data-toggle-target="hacienda-panel-body" data-toggle-name="hacienda" title="Mostrar/ocultar" aria-label="Mostrar hacienda" aria-expanded="false"></button>
                <img class="transaction-broker-logo panel-header-logo" src="/images/brokers/aeat.png" style="border-radius: 6px; background: #fff;" alt="Agencia Tributaria" title="Agencia Tributaria" />
                Ganancias y pérdidas patrimoniales <span class="panel-head-subtitle">(IRPF · base del ahorro · ejercicio @hac.Year)</span>
            </span>
            <div class="panel-head-actions">
                <span class="transaction-total-summary">@(hac.ToPay >= 0 ? "A pagar" : "A devolver"): <strong class="@toPayClass">@Math.Abs(hac.ToPay).ToString(eurPlain, esCulture)</strong></span>
            </div>
        </div>
        <p class="panel-help-text">Se muestra: Resumen y cuota estimada, Ventas de @hac.Year y compras que se descuentan (FIFO) y Avisos y aspectos a tener en cuenta.</p>
        <div id="hacienda-panel-body" class="hacienda-panel-body transaction-broker-grid is-collapsed">
            <div class="transaction-broker-card">
                <div class="transaction-broker-header"><div class="transaction-broker-name"><span>Resumen y cuota estimada</span></div></div>
                <div class="table-wrap">
                    <table class="market-table market-table-grid transaction-table">
                        <tbody>
                            <tr><td>Ganancias patrimoniales de @hac.Year</td><td class="text-align-right price-cell">@hac.Gains.ToString(eurSigned, esCulture)</td></tr>
                            <tr><td>Pérdidas patrimoniales computables</td><td class="text-align-right price-cell">@hac.Losses.ToString(eurSigned, esCulture)</td></tr>
                            @if (hac.DeferredLosses > 0)
                            {
                                <tr><td>Pérdidas diferidas por recompra (no computan, norma 2 meses / 1 año)</td><td class="text-align-right price-cell">@((-hac.DeferredLosses).ToString(eurSigned, esCulture))</td></tr>
                            }
                            <tr><td><strong>Saldo neto de transmisiones</strong></td><td class="text-align-right price-cell"><strong>@hac.NetResult.ToString(eurSigned, esCulture)</strong></td></tr>
                            @if (hac.PriorLossesApplied > 0)
                            {
                                <tr><td>Pérdidas de ejercicios anteriores compensadas</td><td class="text-align-right price-cell">@((-hac.PriorLossesApplied).ToString(eurSigned, esCulture))</td></tr>
                            }
                            <tr><td>Otros rendimientos del ahorro (dividendos, intereses… · se editan en el panel Capital mobiliario)</td><td class="text-align-right price-cell">@hac.OtherIncome.ToString(eurSigned, esCulture)</td></tr>
