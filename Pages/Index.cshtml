                                <tr><td>0029-0035</td><td>Resto de ingresos íntegros de capital mobiliario (seguros, rentas, cesión de capitales, etc.)</td><td class="text-align-right"><input type="text" class="hacienda-casilla-input" name="otrosIngresos" inputmode="decimal" value="@Num(cap.OtrosIngresos)" /></td></tr>
                                <tr class="transaction-row-current-year"><td>0036</td><td><strong>Total de ingresos íntegros</strong> [(27)+(28)+(29)+(30)+(31)+(32)+(33)+(34)+(35)]</td><td class="text-align-right price-cell"><strong>@Model.CapitalTotalIngresos.ToString(eurPlain, esCulture)</strong></td></tr>
                                <tr><td>0037</td><td>Gastos de administración y depósito</td><td class="text-align-right"><input type="text" class="hacienda-casilla-input" name="gastosAdministracion" inputmode="decimal" value="@Num(cap.GastosAdministracion)" /></td></tr>
                                <tr><td>0038</td><td>Rendimiento neto [(36)-(37)]</td><td class="text-align-right price-cell">@Model.CapitalNeto.ToString(eurPlain, esCulture)</td></tr>
                                <tr><td>0040</td><td>Rendimiento neto reducido [(38)-(39)]</td><td class="text-align-right price-cell">@Model.CapitalNeto.ToString(eurPlain, esCulture)</td></tr>
                                <tr class="transaction-row-current-year"><td>0041</td><td><strong>Suma de rendimientos de capital mobiliario a integrar en la base imponible del ahorro</strong></td><td class="text-align-right price-cell"><strong>@Model.CapitalNeto.ToString(eurPlain, esCulture)</strong></td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="hacienda-inputs-form">
                        <button type="submit" class="mini-button">Guardar y recalcular</button>
                    </div>
