                                    @item.ValorLiquidativo.ToString("#,##0.00 €")
                                </td>
                                <td class="price-cell price-cell-quote col-capital-invertido">@item.CapitalInvertido.ToString("#,##0.00 €")</td>
                                <td class="@((item.RentabilidadUltimoMes >= 0 ? "text-success" : "text-danger")) col-rent-mes">@item.RentabilidadUltimoMes.ToString("+#,##0.00;-#,##0.00;0.00")% @(item.RentabilidadUltimoMes >= 0 ? "▲" : "▼")</td>
                                <td class="@((item.Rentabilidad12Meses >= 0 ? "text-success" : "text-danger")) col-rent-12m">@item.Rentabilidad12Meses.ToString("+#,##0.00;-#,##0.00;0.00")% @(item.Rentabilidad12Meses >= 0 ? "▲" : "▼")</td>
                                <td class="price-cell price-cell-quote col-valoracion-actual">@saldoTotal.ToString("#,##0.00 €")</td>
                                <td class="@((rentabilidadDesdeInicio >= 0 ? "text-success" : "text-danger")) col-rent-inicio">@rentabilidadDesdeInicio.ToString("+#,##0.00;-#,##0.00;0.00")% @(rentabilidadDesdeInicio >= 0 ? "▲" : "▼")<br />@gananciaDesdeInicio.ToString("+#,##0.00 €;-#,##0.00 €;0.00 €")</td>
                                <td class="isin-cell col-codigo-dgsfp" style="white-space: nowrap;">@item.CodigoDgsfp</td>
                                <td class="broker-cell">
                                    @if (isIngDirect)
                                    {
                                        <img class="broker-logo" src="/images/brokers/ing.png" alt="ING Direct" title="ING Direct" />
                                    }
                                    else if (isTradeRepublic)
                                    {
                                        <img class="broker-logo" src="/images/brokers/traderepublic.png" alt="Trade Republic" title="Trade Republic" />
                                    }
                                    else if (isOccident)
                                    {
                                        <img class="broker-logo" src="/images/brokers/occident.png" alt="Occident" title="Occident" />
                                    }
                                </td>
                                <td class="time-cell col-actualizacion">@DateTime.Now.ToString("dd/MM/yyyy")<br />@DateTime.Now.ToString("HH:mm")</td>
                                <td class="delete-cell">
                                    <button type="button" class="icon-button-edit" data-dialog-target="edit-pensionplan-@Model.PensionPlans.IndexOf(item)" title="Editar">✎</button>
                                    <form method="post" asp-page-handler="DeletePensionPlan" onsubmit="return confirm('¿Eliminar este plan de pensiones?');">
                                        <input type="hidden" name="name" value="@item.Name" />
                                        <button type="submit" class="icon-button-delete" title="Eliminar">✕</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
