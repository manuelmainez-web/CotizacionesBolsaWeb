    <div class="market-tab-shell mt-4 broker-tabs-shell">
        <ul class="nav nav-tabs market-tabs broker-tabs" id="broker-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="broker-ing-tab" data-bs-toggle="tab" data-bs-target="#broker-ing-tab-pane" type="button" role="tab" aria-controls="broker-ing-tab-pane" aria-selected="true"><img class="broker-tab-logo broker-tab-logo-ing" src="/images/brokers/ing.png" alt="" /><span translate="no" class="notranslate">Ingdirect</span></button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="broker-tr-tab" data-bs-toggle="tab" data-bs-target="#broker-tr-tab-pane" type="button" role="tab" aria-controls="broker-tr-tab-pane" aria-selected="false"><img class="broker-tab-logo" src="/images/brokers/traderepublic.png" alt="" /><span translate="no" class="notranslate">TradeRepublic</span></button>
            </li>
        </ul>
        <div class="tab-content broker-tab-content">
            <div class="tab-pane fade show active" id="broker-ing-tab-pane" role="tabpanel" aria-labelledby="broker-ing-tab">

    @{
        var esCulture = System.Globalization.CultureInfo.GetCultureInfo("es-ES");
        var excelKinds = new[]
        {
            new { Key = "purchase", Title = "Compras", TotalLabel = "Importe total compras", Sign = -1m, Rows = Model.ExcelPurchases, EmptyText = "No hay compras cargadas. Usa \"Cargar Excel\" para importarlas." },
            new { Key = "sale", Title = "Ventas", TotalLabel = "Importe total ventas", Sign = 1m, Rows = Model.ExcelSales, EmptyText = "No hay ventas cargadas. Usa \"Cargar Excel\" para importarlas." }
        };
    }
    @if (!string.IsNullOrWhiteSpace(Model.CheckingAccountError))
    {
        <div class="form-error-banner">@Model.CheckingAccountError</div>
    }
    @{
        var checkingEntities = new[]
        {
            new { Name = "ING Direct", Code = "ING", PanelClass = "ing-panel", Logo = "/images/brokers/ing.png", TbodyId = "tbody-checkingaccounts-ing", DialogId = "add-checkingaccount-ing-dialog" },
            new { Name = "Trade Republic", Code = "TR", PanelClass = "tr-panel", Logo = "/images/brokers/traderepublic.png", TbodyId = "tbody-checkingaccounts-tr", DialogId = "add-checkingaccount-tr-dialog" }
        };
    }
    @{
        async Task RenderCheckingPanel(string code)
        {
            var entity = checkingEntities.First(e => e.Code == code);
    var entityAccounts = Model.CheckingAccounts.Where(a => a.Name == entity.Name).ToList();
    var checkingTotal = entityAccounts.Sum(a => a.Balance);
    var checkingTotalClass = checkingTotal > 0 ? "hacienda-gain" : (checkingTotal < 0 ? "hacienda-loss" : "");
    <div class="market-panel @entity.PanelClass mt-4 market-panel-non-cartera">
        <div class="panel-head panel-head-row">
            <span>
                <button type="button" class="btn-toggle-summary table-toggle-button toggle-left" data-toggle-target="__auto-panel-table__" data-toggle-name="cuenta corriente @entity.Name" title="Mostrar/ocultar" aria-label="Mostrar cuenta corriente @entity.Name" aria-expanded="false"></button>
                Cuenta corriente
            </span>
            <button type="button" class="mini-button" data-dialog-target="@entity.DialogId">+ Añadir Cuenta</button>
            <span class="transaction-total-summary broker-head-figure"><span class="figure-label">Total:</span> <strong class="@checkingTotalClass">@checkingTotal.ToString("#,##0.00 €", System.Globalization.CultureInfo.GetCultureInfo("es-ES"))</strong></span>
        </div>
        <div class="table-wrap is-collapsed">
            <table class="market-table market-table-grid market-table-cuentas" style="table-layout: fixed; width: 1245px;">
                <thead>
                    <tr>
                        <th class="col-nombre-wide" style="width: 942px;">Nombre</th>
                        <th class="text-align-right" style="width: 122px;">Saldo cuenta corriente</th>
                        <th class="text-align-right" style="width: 115px;">Actualización</th>
                        <th style="width: 66px;"></th>
                    </tr>
                </thead>
                <tbody id="@entity.TbodyId">
                    @if (entityAccounts.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="empty-state-cell">No hay cuenta corriente de @entity.Name. Usa "+ Añadir Cuenta" para empezar.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in entityAccounts)
                        {
                            <tr data-broker="@(item.Name == "Trade Republic" ? "TR" : "ING")">
                                <td class="name-cell">
                                    <span class="name-with-flag">
                                        @if (item.Name == "Trade Republic")
                                        {
                                            <img class="broker-logo" src="/images/brokers/traderepublic.png" alt="Trade Republic" title="Trade Republic" />
                                        }
                                        else
                                        {
                                            <img class="broker-logo" src="/images/brokers/ing.png" alt="ING Direct" title="ING Direct" />
                                        }
                                        @item.Name
                                    </span>
                                </td>
                                <td class="price-cell price-cell-quote">@item.Balance.ToString("#,##0.00 €")</td>
                                <td class="time-cell">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="delete-cell">
                                    <button type="button" class="icon-button-edit" data-dialog-target="edit-checkingaccount-@Model.CheckingAccounts.IndexOf(item)" title="Editar">✎</button>
                                    <form method="post" asp-page-handler="DeleteCheckingAccount" onsubmit="return confirm('¿Eliminar esta cuenta corriente?');">
                                        <input type="hidden" name="name" value="@item.Name" />
                                        <button type="submit" class="icon-button-delete" title="Eliminar">✕</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
        }
    }

    <div class="summary-panel summary-panel-ing">
        <div class="summary-strip-label" id="summary-strip-label-ing">
            <button type="button" class="btn-toggle-summary" data-toggle-target="summary-strip-ing" data-toggle-name="resumen ING" title="Mostrar/ocultar">Mostrar</button>
            <span class="broker-label-text">
                <span translate="no" class="notranslate">Resumen total de las posiciones</span>
            </span>
            <span class="summary-label-gain notranslate" translate="no"><span class="figure-label">Rentabilidad:</span> @Model.IngGainPercent.ToString("+#,##0.00;-#,##0.00;0.00")% (@Model.IngGainValue.ToString("+#,##0.00 €;-#,##0.00 €;0.00 €"))</span>
        </div>
        <p class="summary-help-text">Se muestra el resumen correspondiente a todas las operaciones de compra venta realizadas desde INGDIRECT, indicando la rentabilidad total obtenida. También calculamos la rentabilidad tomando como referencia un importe dado.</p>
        <div class="summary-strip is-collapsed" id="summary-strip-ing">
            <div class="summary-box invested">
                <span>Importe total invertido</span>
                <strong>@Model.IngPurchaseValue.ToString("#,##0.00 €")</strong>
            </div>
            <div class="summary-box gain">
                <span>Rentabilidad total</span>
                <strong>@Model.IngGainPercent.ToString("+#,##0.00;-#,##0.00;0.00")% (@Model.IngGainValue.ToString("+#,##0.00 €;-#,##0.00 €;0.00 €"))</strong>
            </div>
            <div class="summary-box @(Model.IngGainValue >= 0 ? "gain" : "loss")">
                <span>Importe total</span>
                <strong>@((Model.IngPurchaseValue + Model.IngGainValue).ToString("#,##0.00 €"))</strong>
            </div>
            <div class="rendimiento-ref-panel" id="rendimiento-ref-ing" data-valor="@Model.RendimientoReferenciaIng" data-total="@((Model.IngPurchaseValue + Model.IngGainValue).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))">
                @Html.AntiForgeryToken()
                <label class="rendimiento-ref-label" for="rendimiento-ref-ing-input">Importe de referencia para Rendimiento temporal:</label>
                <input type="text" inputmode="decimal" autocomplete="off" class="rendimiento-ref-input" id="rendimiento-ref-ing-input" />
                <span class="rendimiento-ref-total notranslate" translate="no">@((Model.IngPurchaseValue + Model.IngGainValue).ToString("#,##0.00 €")) =</span>
                <input type="text" readonly tabindex="-1" class="rendimiento-ref-input rendimiento-ref-result" id="rendimiento-ref-ing-result" aria-label="Importe total ING Direct menos importe de referencia" />
            </div>
        </div>
    </div>

    <div class="market-panel ing-panel mt-4">
        <div class="panel-head panel-head-row">
            <span>
                <button type="button" class="btn-toggle-summary table-toggle-button toggle-left" data-toggle-target="transaction-broker-grid-excel" data-toggle-name="operaciones de compra y venta Excel" title="Mostrar/ocultar" aria-label="Mostrar operaciones de compra y venta" aria-expanded="false"></button>
                Operaciones de compra y venta
            </span>
            <div class="panel-head-actions">
                <form method="post" enctype="multipart/form-data" asp-page-handler="ImportExcelTransactions" style="display: inline-block; margin: 0;">
                    <label class="mini-button" style="cursor: pointer; margin: 0;" title="Cargar operaciones desde un fichero Excel (.xlsx o .xls)">
                        Cargar Excel
                        <input type="file" name="file" accept=".xlsx,.xls" style="display: none;" onchange="if (this.files.length) { this.form.submit(); }" />
                    </label>
                </form>
                @if (Model.ExcelTransactions.Count > 0)
                {
                    <form method="post" asp-page-handler="ClearExcelTransactions" style="display: inline-block; margin: 0;" onsubmit="return confirm('¿Eliminar todas las operaciones cargadas desde Excel?');">
                        <button type="submit" class="mini-button mini-button-secondary">Vaciar</button>
                    </form>
                }
            </div>
        </div>
        <p class="panel-help-text">A la hora de cargar un fichero Excel con movimientos, tendrá que ser del tipo de los que elabora INGDIRECT cuando se exportan movimientos del Broker Naranja. El fichero en formato XLS es el que se debe utilizar para la carga de movimientos diferenciados por Título. Importante: en los ficheros Excel habrá que modificar el campo, valor, por el código ISIN asociado al título correspondiente.</p>
        @if (!string.IsNullOrWhiteSpace(Model.ExcelTransactionsError))
        {
            <div class="form-error-banner">@Model.ExcelTransactionsError</div>
        }
        <div id="transaction-broker-grid-excel" class="transaction-broker-grid is-collapsed">
            @foreach (var kind in excelKinds)
            {
                var kindTotal = kind.Sign * kind.Rows.Sum(r => Math.Abs(r.ImporteTotal));
                var titleGroups = kind.Rows
                    .GroupBy(r =>
                    {
                        var parts = Model.GetTransactionTitleParts(r);
                        return string.IsNullOrWhiteSpace(parts.Isin) ? "t:" + parts.Nombre.Trim().ToLowerInvariant() : "i:" + parts.Isin;
                    })
                    .Select(g =>
                    {
                        var parts = Model.GetTransactionTitleParts(g.First());
                        var groupRows = g.OrderByDescending(r => r.FechaOperacion).ToList();
                        return new
                        {
                            Isin = parts.Isin,
                            Nombre = parts.Nombre,
                            Label = string.IsNullOrWhiteSpace(parts.Nombre) ? parts.Isin : parts.Nombre,
                            Rows = groupRows,
                            Total = kind.Sign * groupRows.Sum(r => Math.Abs(r.ImporteTotal))
                        };
                    })
                    .OrderBy(g => g.Label, StringComparer.OrdinalIgnoreCase)
                    .ToList();

                <div class="transaction-broker-card" data-transaction-type="@kind.Key">
                    <div class="transaction-broker-header">
                        <div class="transaction-broker-name">
                            <span>@kind.Title</span>
                            <span class="transaction-total-summary">(@kind.TotalLabel: @kindTotal.ToString("+#,##0.00 €;-#,##0.00 €;0.00 €", esCulture))</span>
                        </div>
