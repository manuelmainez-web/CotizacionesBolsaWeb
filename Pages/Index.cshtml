                                <th class="text-align-right">N.º títulos</th>
                                <th class="text-align-right">Transmisión (Valor de venta)</th>
                                <th class="text-align-right">Coste fijo (Valor de compra)</th>
                                <th class="text-align-right">Resultado</th>
                                <th class="text-align-right">Computa</th>
                            </tr>
                        </thead>
                        <tbody>
