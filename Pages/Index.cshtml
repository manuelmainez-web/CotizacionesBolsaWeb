@section Scripts {
    <script>
        (function () {
            function normalizeMoneyValue(value) {
                var source = String(value ?? '').trim();
                if (!source) {
                    return '0';
                }

                source = source.replace(/\u00A0/g, '').replace(/€/g, '').replace(/\s/g, '');
                if (!source) {
                    return '0';
                }

                var sanitized = source.replace(/[^0-9,.-]/g, '');
                if (!sanitized || sanitized === '-' || sanitized === '.' || sanitized === ',') {
                    return '0';
                }

                if (sanitized.indexOf(',') !== -1 && sanitized.indexOf('.') !== -1) {
                    var lastComma = sanitized.lastIndexOf(',');
                    var lastDot = sanitized.lastIndexOf('.');
                    if (lastComma > lastDot) {
                        sanitized = sanitized.replace(/\./g, '').replace(',', '.');
                    } else {
                        sanitized = sanitized.replace(/,/g, '');
                    }
                } else if (sanitized.indexOf(',') !== -1) {
                    sanitized = sanitized.replace(/\./g, '').replace(',', '.');
                }

                return sanitized;
            }

            function formatSpanishNumber(value, decimalPlaces) {
                var numberValue = Number(normalizeMoneyValue(value));
                if (!Number.isFinite(numberValue)) {
                    return '0';
                }

                var decimals = typeof decimalPlaces === 'number' ? decimalPlaces : 0;
                var fixed = numberValue.toFixed(decimals);
                var parts = fixed.split('.');
                var integerPart = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                var decimalPart = parts.length > 1 ? ',' + parts[1] : '';
                return integerPart + decimalPart;
            }

            function formatCurrency(value) {
                return formatSpanishNumber(value, 2) + ' €';
            }

            function formatDate(value) {
                var date = new Date(value);
                if (Number.isNaN(date.getTime())) {
                    return value;
                }
                return date.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });
            }

            function normalizeDecimalInputValue(value) {
                if (value === null || value === undefined) {
                    return '';
                }

                var source = String(value).replace(/\u00A0/g, '').trim();
                if (!source) {
                    return '';
                }

                var cleaned = source.replace(/[^\d,.-]/g, '');
                if (!cleaned || cleaned === '-' || cleaned === '.' || cleaned === ',') {
                    return '';
                }

                var numberOfCommas = (cleaned.match(/,/g) || []).length;
                var numberOfDots = (cleaned.match(/\./g) || []).length;

                if (numberOfCommas === 0 && numberOfDots > 0) {
                    var lastDotIndex = cleaned.lastIndexOf('.');
                    var fractionPart = cleaned.substring(lastDotIndex + 1);
                    if (fractionPart.length <= 2) {
                        return cleaned.substring(0, lastDotIndex) + ',' + fractionPart;
                    }

                    return cleaned.replace(/\./g, '');
                }

                if (numberOfCommas > 0 && numberOfDots === 0) {
                    var lastCommaIndex = cleaned.lastIndexOf(',');
                    var fractionPartComma = cleaned.substring(lastCommaIndex + 1);
                    if (fractionPartComma.length <= 2) {
                        return cleaned;
                    }

                    return cleaned.replace(/,/g, '');
                }

                if (numberOfCommas > 0 && numberOfDots > 0) {
                    var lastCommaIndex2 = cleaned.lastIndexOf(',');
                    var lastDotIndex2 = cleaned.lastIndexOf('.');
                    if (lastCommaIndex2 > lastDotIndex2) {
                        return cleaned.replace(/\./g, '').replace(',', '.');
                    }

                    return cleaned.replace(/,/g, '');
                }

                return cleaned;
            }

            function normalizeDecimalInputForSubmit(input) {
                if (!input || !input.value) {
                    return;
                }

                if (input.type === 'text' && input.getAttribute('inputmode') === 'decimal') {
                    input.value = normalizeDecimalInputValue(input.value);
                }
            }

            function formatDecimalInput(value) {
                var parsed = parseDecimalLocale(value);
                if (!Number.isFinite(parsed)) {
                    return '0,00';
                }
                return parsed.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function parseDecimalLocale(value) {
                var source = String(value ?? '0').trim();
                if (!source) {
                    return 0;
                }

                var sanitized = source
                    .replace(/€/g, '')
                    .replace(/\s/g, '')
                    .replace(/[^\d,.-]/g, '');

                if (!sanitized || sanitized === '-' || sanitized === '.' || sanitized === ',') {
                    return 0;
                }

                var lastComma = sanitized.lastIndexOf(',');
                var lastDot = sanitized.lastIndexOf('.');
                var normalized;

                if (lastComma !== -1 && lastDot !== -1) {
                    normalized = lastComma > lastDot
                        ? sanitized.replace(/\./g, '').replace(',', '.')
                        : sanitized.replace(/,/g, '');
                } else if (lastComma !== -1) {
                    var fractionLength = sanitized.length - lastComma - 1;
                    normalized = fractionLength <= 2
                        ? sanitized.replace(',', '.')
                        : sanitized.replace(/,/g, '');
                } else {
                    var dotParts = sanitized.split('.');
                    if (dotParts.length > 2) {
                        normalized = dotParts.slice(0, -1).join('') + '.' + dotParts[dotParts.length - 1];
                    } else {
                        normalized = sanitized;
                    }
                }

                var parsed = Number(normalized);
                return Number.isFinite(parsed) ? parsed : 0;
            }

            function parseMoney(value) {
                if (typeof value === 'number' && Number.isFinite(value)) {
                    return value;
                }

                var normalized = normalizeMoneyValue(value);
                var parsed = Number(normalized);
                return Number.isFinite(parsed) ? parsed : 0;
            }

            function formatNumber(value) {
                var numericValue = Number(value || 0);
                if (!Number.isFinite(numericValue)) {
                    return '0';
                }

                var formatted = numericValue.toFixed(6).replace(/\.?0+$/, '');
                var parts = formatted.split('.');
                parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                return parts.join(',');
            }

            function setupDecimalTextInput(input) {
                if (!input) {
                    return;
                }

                input.setAttribute('inputmode', 'decimal');
                input.setAttribute('lang', 'es-ES');

                input.addEventListener('keydown', function (event) {
                    if (event.key === ',' || event.key === '.') {
                        event.preventDefault();
                        if (/[.,]/.test(input.value)) {
                            return;
                        }
                        var separator = ',';
                        var start = input.selectionStart ?? input.value.length;
                        var end = input.selectionEnd ?? input.value.length;
                        var nextValue = input.value.slice(0, start) + separator + input.value.slice(end);
                        input.value = nextValue;
                        var caret = start + 1;
                        if (typeof input.setSelectionRange === 'function') {
                            requestAnimationFrame(function () {
                                input.setSelectionRange(caret, caret);
                            });
                        }
                    }
                });

                input.addEventListener('input', function () {
                    var normalized = normalizeDecimalInputValue(input.value);
                    if (normalized !== input.value) {
                        input.value = normalized;
                    }
                });

                input.addEventListener('blur', function () {
                    if (input.id === 'transaction-importe-field') {
                        input.value = formatDecimalInput(input.value);
                    }
                });
            }

            document.addEventListener('DOMContentLoaded', function () {
                document.querySelectorAll('input[type="number"], input[type="text"][inputmode="decimal"]').forEach(function (input) {
                    input.setAttribute('inputmode', 'decimal');
                    input.setAttribute('lang', 'es-ES');

                    input.addEventListener('keydown', function (event) {
                        if (event.key === ',' || event.key === '.') {
                            event.preventDefault();
                            if (/[.,]/.test(input.value)) {
                                return;
                            }
                            var separator = ',';
                            var start = input.selectionStart ?? input.value.length;
                            var end = input.selectionEnd ?? input.value.length;
                            var nextValue = input.value.slice(0, start) + separator + input.value.slice(end);
                            input.value = nextValue;
                            var caret = start + 1;
                            if (typeof input.setSelectionRange === 'function') {
                                requestAnimationFrame(function () {
                                    input.setSelectionRange(caret, caret);
                                });
                            }
                        }
                    });

                    input.addEventListener('change', function () {
                        var normalized = normalizeDecimalInputValue(input.value);
                        if (normalized !== input.value) {
                            input.value = normalized;
                        }
                    });
                });

                document.querySelectorAll('form').forEach(function (form) {
                    form.addEventListener('submit', function () {
                        form.querySelectorAll('input[type="text"][inputmode="decimal"]').forEach(function (input) {
                            normalizeDecimalInputForSubmit(input);
                        });
                    });
                });

                ['transaction-quantity-field', 'transaction-importe-field'].forEach(function (fieldId) {
                    setupDecimalTextInput(document.getElementById(fieldId));
                });
            });

            function getStorageKey(type, brokerCode) {
                return 'cotizaciones.transactions.' + type + '.' + brokerCode;
            }

            function generateRowId() {
                return 'tx-' + Date.now() + '-' + Math.random().toString(16).slice(2, 10);
            }

            function normalizeTitleFieldValue(title) {
                var normalized = String(title || '').trim();
                if (!normalized) {
                    var select = document.getElementById('transaction-title-field');
                    if (select) {
                        select.value = '';
                    }
                    return '';
                }

                var select = document.getElementById('transaction-title-field');
                if (select) {
                    var exists = Array.prototype.some.call(select.options, function (option) {
                        return String(option.value || '').trim().toLowerCase() === normalized.toLowerCase();
                    });

                    if (!exists) {
                        var option = document.createElement('option');
                        option.value = normalized;
                        option.textContent = normalized;
                        select.appendChild(option);
                    }

                    select.value = normalized;
                    return normalized;
                }

                var datalist = document.getElementById('transaction-title-options');
                if (datalist) {
                    var existsInDatalist = Array.prototype.some.call(datalist.options, function (option) {
                        return String(option.value || '').trim().toLowerCase() === normalized.toLowerCase();
                    });

                    if (!existsInDatalist) {
                        var datalistOption = document.createElement('option');
                        datalistOption.value = normalized;
                        datalist.appendChild(datalistOption);
                    }
                }

                var input = document.getElementById('transaction-title-field');
                if (input) {
                    input.value = normalized;
                }

                return normalized;
            }

            function sanitizeStoredRows(rows) {
                if (!Array.isArray(rows)) {
                    return [];
                }

                return rows.filter(function (row) {
                    if (!row || typeof row !== 'object') {
                        return false;
                    }

                    var title = String(row.titulo || row.concept || '').trim();
                    if (!title) {
                        return false;
                    }

                    return !/(PLAN\s*2030|Compra prueba|COMPRA PRUEBA|Amundi EURO STOXX 50 Daily|PRUEBA|compra prueba)/i.test(title);
                });
            }

            function readExistingRows(card) {
                var rows = [];
                Array.prototype.forEach.call(card.querySelectorAll('tbody tr'), function (row) {
                    if (row.querySelector('.empty-state-cell')) {
                        return;
                    }
                    var cells = row.querySelectorAll('td');
                    if (cells.length < 5) {
                        return;
                    }
                    var title = cells[0].textContent.trim();
                    var tipo = cells[1].textContent.trim();
                    var cantidad = parseDecimalLocale(cells[2].textContent);
                    rows.push({
                        id: row.getAttribute('data-row-id') || generateRowId(),
                        titulo: title,
                        tipoOperacion: tipo,
                        numeroTitulos: cantidad,
                        importeTotal: parseMoney(cells[3].textContent),
                        fechaOperacion: cells[4].textContent.trim(),
                        concept: title,
                        valor: parseMoney(cells[3].textContent)
                    });
                });
                return rows;
            }

            function sortTransactionRows(rows) {
                if (!Array.isArray(rows)) {
                    return [];
                }

                return rows.slice().sort(function (left, right) {
                    var leftDate = new Date(left && left.fechaOperacion ? left.fechaOperacion : 0);
                    var rightDate = new Date(right && right.fechaOperacion ? right.fechaOperacion : 0);
                    var leftValue = Number.isNaN(leftDate.getTime()) ? 0 : leftDate.getTime();
                    var rightValue = Number.isNaN(rightDate.getTime()) ? 0 : rightDate.getTime();

                    if (rightValue !== leftValue) {
                        return rightValue - leftValue;
                    }

                    var leftImporte = Number(left && left.importeTotal !== undefined ? left.importeTotal : 0);
                    var rightImporte = Number(right && right.importeTotal !== undefined ? right.importeTotal : 0);
                    if (rightImporte !== leftImporte) {
                        return rightImporte - leftImporte;
                    }

                    return String(left && left.titulo ? left.titulo : '').localeCompare(String(right && right.titulo ? right.titulo : ''), 'es', { sensitivity: 'base' });
                });
            }

            function renderTable(card, rows) {
                var tbody = card.querySelector('tbody');
                if (!tbody) {
                    return;
                }

                var sortedRows = sortTransactionRows(rows);

                if (!sortedRows || sortedRows.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="empty-state-cell">No hay movimientos registrados para este broker.</td></tr>';
                    return;
                }

                tbody.innerHTML = sortedRows.map(function (row, index) {
                    var rowId = row.id || ((row.titulo || row.concept || 'row') + '-' + index);
                    var title = row.titulo || row.concept || '';
                    var operation = row.tipoOperacion || getOperationFromRow(row, card);
                    var quantity = row.numeroTitulos !== undefined && row.numeroTitulos !== null ? row.numeroTitulos : (row.cantidad !== undefined ? row.cantidad : 0);
                    return '<tr data-row-id="' + rowId + '">' +
                        '<td>' + title + '</td>' +
                        '<td>' + operation + '</td>' +
                        '<td class="text-align-right">' + formatNumber(quantity) + '</td>' +
                        '<td class="text-align-right price-cell">' + formatCurrency(row.importeTotal) + '</td>' +
                        '<td class="text-align-right">' + formatDate(row.fechaOperacion) + '</td>' +
                        '<td class="delete-cell">' +
                        '<button type="button" class="icon-button-edit transaction-edit-row" title="Editar">✎</button>' +
                        '<button type="button" class="icon-button-delete transaction-delete-row" title="Eliminar">✕</button>' +
                        '</td>' +
                        '</tr>';
                }).join('');
            }

            function safeGetStoredRows(card) {
                var key = getStorageKey(card.getAttribute('data-transaction-type'), card.getAttribute('data-broker-code'));
                try {
                    var parsed = JSON.parse(localStorage.getItem(key) || '[]');
                    return sanitizeStoredRows(Array.isArray(parsed) ? parsed : []);
                } catch (error) {
                    return [];
                }
            }

            function mergeUniqueRows(baseRows, incomingRows) {
                var merged = [];
                var seen = new Map();

                function pushRow(row, preferIncoming) {
                    if (!row || typeof row !== 'object') {
                        return;
                    }

                    var signature = row.id || [
                        String(row.titulo || row.concept || ''),
                        String(row.tipoOperacion || ''),
                        String(row.numeroTitulos !== undefined ? row.numeroTitulos : row.cantidad || 0),
                        String(row.importeTotal !== undefined ? row.importeTotal : 0),
                        String(row.fechaOperacion || '')
                    ].join('||');

                    if (seen.has(signature)) {
                        var index = seen.get(signature);
                        if (preferIncoming) {
                            merged[index] = row;
                        }
                        return;
                    }

                    seen.set(signature, merged.length);
                    merged.push(row);
                }

                if (Array.isArray(baseRows)) {
                    baseRows.forEach(function (row) {
                        pushRow(row, false);
                    });
                }

                if (Array.isArray(incomingRows)) {
                    incomingRows.forEach(function (row) {
                        pushRow(row, true);
                    });
                }

                return merged;
            }

            function saveRows(card, rows) {
                var key = getStorageKey(card.getAttribute('data-transaction-type'), card.getAttribute('data-broker-code'));
                var mergedRows = mergeUniqueRows(safeGetStoredRows(card), rows);
                localStorage.setItem(key, JSON.stringify(sortTransactionRows(mergedRows)));
            }

            var activeTransactionCard = null;

            function getTransactionConcept(type, title) {
                var label = type === 'purchase' ? 'COMPRA' : 'VENTA';
                return title ? label + ' - ' + title : label;
            }

            function resolveTitleFromConcept(concept) {
                if (!concept) {
                    return '';
                }
                var parts = String(concept).split(' - ');
                return parts.length > 1 ? parts.slice(1).join(' - ') : '';
            }

            function getOperationFromRow(row, card) {
                if (row && row.tipoOperacion) {
                    return row.tipoOperacion;
                }
                if (row && row.concept) {
                    var concept = String(row.concept).toUpperCase();
                    if (concept.indexOf('VENTA') === 0) {
                        return 'VENTA';
                    }
                    if (concept.indexOf('COMPRA') === 0) {
                        return 'COMPRA';
                    }
                }
                return card && card.getAttribute('data-transaction-type') === 'sale' ? 'VENTA' : 'COMPRA';
            }

            function findRowByIdentity(allRows, row) {
                if (!Array.isArray(allRows) || !row) {
                    return null;
                }

                var rowId = row.getAttribute('data-row-id');
                if (rowId) {
                    return allRows.find(function (item) {
                        return item && item.id && String(item.id) === String(rowId);
                    }) || null;
                }

                var cells = row.querySelectorAll('td');
                if (cells.length < 5) {
                    return null;
                }

                var title = cells[0].textContent.trim();
                var amount = parseMoney(cells[3].textContent);
                var date = cells[4].textContent.trim();

                return allRows.find(function (item) {
                    if (!item) {
                        return false;
                    }

                    var itemTitle = String(item.titulo || item.concept || '').trim();
                    var itemDate = String(item.fechaOperacion || '').trim();
                    var itemAmount = Number(item.importeTotal || 0);

                    return itemTitle === title && Math.abs(itemAmount - amount) < 0.01 && String(itemDate).slice(0, 10) === String(date).slice(0, 10);
                }) || null;
            }

            function openTransactionDialog(card, currentRow, rowIndex) {
                var dialog = document.getElementById('transaction-entry-dialog');
                var form = document.getElementById('transaction-entry-form');
                var type = card.getAttribute('data-transaction-type');
                var brokerCode = card.getAttribute('data-broker-code');
                var formTitle = document.getElementById('transaction-dialog-title');
                var titleField = document.getElementById('transaction-title-field');
                var operationField = document.getElementById('transaction-operation-field');
                var quantityField = document.getElementById('transaction-quantity-field');
                var importeField = document.getElementById('transaction-importe-field');
                var fechaField = document.getElementById('transaction-fecha-field');
                var typeField = document.getElementById('transaction-type-field');
                var brokerField = document.getElementById('transaction-broker-field');
                var rowIndexField = document.getElementById('transaction-row-index-field');

                activeTransactionCard = card;
                typeField.value = type;
                brokerField.value = brokerCode;
                rowIndexField.value = rowIndex === null || rowIndex === undefined ? '' : String(rowIndex);

                var operationValue = type === 'purchase' ? 'COMPRA' : 'VENTA';
                formTitle.textContent = currentRow ? 'Editar ' + (type === 'purchase' ? 'compra' : 'venta') : 'Añadir ' + (type === 'purchase' ? 'compra' : 'venta');
                if (operationField) {
                    operationField.value = operationValue;
                }

                var defaultTitle = titleField && titleField.value ? String(titleField.value).trim() : '';
                var selectedTitle = currentRow ? (currentRow.titulo || resolveTitleFromConcept(currentRow.concept)) : defaultTitle;
                if (titleField) {
                    titleField.value = normalizeTitleFieldValue(selectedTitle || defaultTitle);
                }
                quantityField.value = currentRow ? String(currentRow.numeroTitulos || currentRow.cantidad || 1) : '1';
                importeField.value = currentRow ? formatDecimalInput(currentRow.importeTotal || 0) : '0.00';
                fechaField.value = currentRow ? String(currentRow.fechaOperacion || '').substring(0, 10) : new Date().toISOString().substring(0, 10);

                if (dialog && typeof dialog.showModal === 'function') {
                    dialog.showModal();
                }
            }

            function closeTransactionDialog() {
                var dialog = document.getElementById('transaction-entry-dialog');
                var form = document.getElementById('transaction-entry-form');
                if (dialog && dialog.close) {
                    form.reset();
                    dialog.close();
                }
            }

            function attachCardHandlers(card) {
                var key = getStorageKey(card.getAttribute('data-transaction-type'), card.getAttribute('data-broker-code'));

                var addButton = card.querySelector('.transaction-add-button');
                if (addButton) {
                    addButton.onclick = function () {
                        openTransactionDialog(card, null, null);
                    };
                }

                card.querySelectorAll('.transaction-edit-row').forEach(function (button) {
                    button.onclick = function () {
                        var row = button.closest('tr');
                        var allRows = safeGetStoredRows(card);
                        var current = findRowByIdentity(allRows, row);
                        var index = Array.prototype.indexOf.call(row.parentNode.children, row);

                        if (!current) {
                            current = allRows[index] || readExistingRows(card)[index] || null;
                        }

                        var resolvedIndex = current && current.id
                            ? allRows.findIndex(function (item) {
                                return item && item.id && String(item.id) === String(current.id);
                            })
                            : index;

                        if (resolvedIndex < 0) {
                            resolvedIndex = index;
                        }

                        openTransactionDialog(card, current, resolvedIndex);
                    };
                });

                card.querySelectorAll('.transaction-delete-row').forEach(function (button) {
                    button.onclick = function () {
                        var row = button.closest('tr');
                        var allRows = safeGetStoredRows(card);
                        var index = Array.prototype.indexOf.call(row.parentNode.children, row);
                        allRows.splice(index, 1);
                        saveRows(card, allRows);
                        renderTable(card, allRows);
                        attachCardHandlers(card);
                    };
                });
            }

            function bindCard(card) {
                var key = getStorageKey(card.getAttribute('data-transaction-type'), card.getAttribute('data-broker-code'));
                var storedRows = safeGetStoredRows(card);
                var domRows = readExistingRows(card);
                var mergedRows = mergeUniqueRows(storedRows, domRows);

                if (Array.isArray(storedRows) && storedRows.length === 0 && localStorage.getItem(key) !== null) {
                    localStorage.removeItem(key);
                }

                var sanitizedRows = sanitizeStoredRows(mergedRows);
                var sortedRows = sortTransactionRows(sanitizedRows);

                if (sortedRows.length > 0) {
                    saveRows(card, sortedRows);
                }

                renderTable(card, sortedRows);
                attachCardHandlers(card);
            }

            var transactionForm = document.getElementById('transaction-entry-form');
            if (transactionForm) {
                transactionForm.addEventListener('submit', function (event) {
                    event.preventDefault();
                    if (!activeTransactionCard) {
                        closeTransactionDialog();
                        return;
                    }

                    var key = getStorageKey(activeTransactionCard.getAttribute('data-transaction-type'), activeTransactionCard.getAttribute('data-broker-code'));
                    var rows = safeGetStoredRows(activeTransactionCard);
                    var rowIndexField = document.getElementById('transaction-row-index-field');
                    var rowIndex = rowIndexField.value === '' ? null : Number(rowIndexField.value);
                    var selectedTitle = normalizeTitleFieldValue(document.getElementById('transaction-title-field').value);
                    var operationType = activeTransactionCard.getAttribute('data-transaction-type') === 'purchase' ? 'COMPRA' : 'VENTA';
                    var row = {
                        titulo: selectedTitle,
                        tipoOperacion: operationType,
                        numeroTitulos: parseDecimalLocale(document.getElementById('transaction-quantity-field').value || '0'),
                        importeTotal: parseMoney(document.getElementById('transaction-importe-field').value),
                        fechaOperacion: document.getElementById('transaction-fecha-field').value,
                        concept: getTransactionConcept(activeTransactionCard.getAttribute('data-transaction-type'), selectedTitle),
                        valor: parseMoney(document.getElementById('transaction-importe-field').value)
                    };

                    if (rowIndex === null || Number.isNaN(rowIndex)) {
                        row.id = generateRowId();
                        rows.push(row);
                    } else {
                        row.id = rows[rowIndex] && rows[rowIndex].id ? rows[rowIndex].id : generateRowId();
                        rows[rowIndex] = row;
                    }

                    var sortedRows = sortTransactionRows(rows);
                    saveRows(activeTransactionCard, sortedRows);
                    renderTable(activeTransactionCard, sortedRows);
                    attachCardHandlers(activeTransactionCard);
                    closeTransactionDialog();
                });
            }

            var transactionCancelButton = document.getElementById('transaction-cancel-button');
            if (transactionCancelButton) {
                transactionCancelButton.addEventListener('click', function () {
                    closeTransactionDialog();
                });
            }

            document.addEventListener('DOMContentLoaded', function () {
                document.querySelectorAll('.transaction-broker-card').forEach(function (card) {
                    bindCard(card);
                });
            });
        })();
    </script>
    <script>
        (function () {
            var classificationSelect = document.getElementById('commodity-classification-select');
            var symbolSelect = document.getElementById('commodity-symbol-select');

            function filtrarMateriasPrimas() {
                if (!classificationSelect || !symbolSelect) {
                    return;
                }
                var seleccionada = classificationSelect.value;
                var primeraVisible = null;
                Array.prototype.forEach.call(symbolSelect.options, function (opcion) {
                    var coincide = opcion.getAttribute('data-classification') === seleccionada;
                    opcion.hidden = !coincide;
                    opcion.disabled = !coincide;
                    if (coincide && !primeraVisible) {
                        primeraVisible = opcion;
                    }
                });
                var actual = symbolSelect.options[symbolSelect.selectedIndex];
                if (!actual || actual.disabled) {
                    if (primeraVisible) {
                        symbolSelect.value = primeraVisible.value;
                    }
                }
            }

            if (classificationSelect && symbolSelect) {
                classificationSelect.addEventListener('change', filtrarMateriasPrimas);
                filtrarMateriasPrimas();
            }
        })();
    </script>
    <script>
        (function () {
            var refreshIntervalMs = 15000;
            var idsAActualizar = [
                'summary-strip-general',
                'summary-strip',
                'summary-strip-ing',
                'summary-strip-tr',
                'tbody-indices',
                'tbody-stocks',
                'tbody-etfs-control',
                'tbody-commodities',
                'tbody-etfs',
                'tbody-funds',
                'tbody-pensionplans',
                'tbody-checkingaccounts',
                'tbody-cash',
                'tbody-portfolio-stocks'
            ];

            function actualizarDatos() {
                var hayDialogoAbierto = document.querySelector('dialog[open]') !== null;
                if (hayDialogoAbierto) {
                    return Promise.resolve();
                }

                return fetch(window.location.href, { cache: 'no-store' })
                    .then(function (respuesta) { return respuesta.text(); })
                    .then(function (html) {
                        var parser = new DOMParser();
                        var docNuevo = parser.parseFromString(html, 'text/html');

                        idsAActualizar.forEach(function (id) {
                            var actual = document.getElementById(id);
                            var nuevo = docNuevo.getElementById(id);
                            if (actual && nuevo) {
                                actual.innerHTML = nuevo.innerHTML;
                            }
                        });
                    })
                    .catch(function () {
                        // Si falla la petición (red, servidor dormido, etc.) simplemente se reintenta en el siguiente ciclo.
                    });
            }

            setInterval(actualizarDatos, refreshIntervalMs);
            window.refreshPageData = actualizarDatos;
        })();
    </script>
}
