@page
@model CotizacionesBolsaWeb.Pages.IndexModel
@{
    ViewData["Title"] = "Cotizaciones bolsa";
}

<div class="market-shell">
    <div class="portfolio-header">
        <div class="title-block">
            <img class="portfolio-header-image" src="/images/portfolio-header.jpg" alt="Cabecera cartera" />
            <h1 class="mb-1">
                <span class="portfolio-name-row">
                    <img class="portfolio-avatar" src="/images/avatar-manuel.jpg" alt="Manuel Máinez Arrojo" />
                    <span class="portfolio-name-text">Manuel Máinez Arrojo</span>
                </span>
            </h1>
            <p class="portfolio-subtitle">Siga de cerca sus instrumentos financieros y el rendimiento de sus posiciones.</p>
            <p class="portfolio-note">Para arrancar la página de cotizaciones bastará con escanear el código QR.</p>
            <p class="portfolio-note portfolio-note-tight">Las cotizaciones se actualizan cada 15 segundos con un desfase de 15 o 20 minutos.</p>
            <div class="blank-line-1"></div>
            <div class="quick-links" translate="no">
                <a class="mini-button quick-link-button notranslate" translate="no" href="https://es.investing.com/indices/major-indices" target="_blank" rel="noopener noreferrer">
                    <img class="quick-link-icon" src="/images/brokers/investing.png" alt="Investing" />
                    <span translate="no" class="notranslate">Investing</span>
                </a>
                <a class="mini-button quick-link-button notranslate" translate="no" href="https://ing.ingdirect.es/app-login/" target="_blank" rel="noopener noreferrer">
                    <img class="quick-link-icon" src="/images/brokers/ing.png" alt="Ingdirect" />
                    <span translate="no" class="notranslate">Ingdirect</span>
                </a>
                <a class="mini-button quick-link-button notranslate" translate="no" href="https://app.traderepublic.com/" target="_blank" rel="noopener noreferrer">
                    <img class="quick-link-icon" src="/images/brokers/traderepublic.png" alt="Trade Republic" />
                    <span translate="no" class="notranslate">Trade Republic</span>
                </a>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.PublicUrl))
        {
            <div class="qr-box">
                <img class="qr-image" src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=@Uri.EscapeDataString(Model.PublicUrl)" alt="Código QR de acceso" />
                <span class="qr-label">Escanea para abrir<br />desde el móvil</span>
            </div>
        }
    </div>

    <div class="summary-strip-label">
        <button type="button" class="btn-toggle-summary" data-toggle-target="summary-strip" title="Mostrar/ocultar">Mostrar</button>
        RESUMEN TOTAL DE LAS POSICIONES
    </div>
    <div class="summary-strip is-collapsed" id="summary-strip">
        <div class="summary-box">
            <span>Importe total invertido</span>
            <strong>@Model.TotalPurchaseValue.ToString("#,##0.00 €")</strong>
        </div>
        <div class="summary-box gain">
            <span>Rentabilidad total</span>
            <strong>@Model.TotalGainPercent.ToString("+#,##0.00;-#,##0.00;0.00")% (@Model.TotalGainValue.ToString("+#,##0.00 €;-#,##0.00 €;0.00 €"))</strong>
        </div>
        <div class="summary-box">
            <span>Importe total</span>
            <strong>@((Model.TotalPurchaseValue + Model.TotalGainValue).ToString("#,##0.00 €"))</strong>
        </div>
    </div>

    <div class="blank-line-1"></div>

    <div class="market-panel">
        <div class="panel-head panel-head-row">
            <span>Índices <span class="panel-head-subtitle">(Control de cotizaciones)</span></span>
            <button type="button" class="mini-button" data-dialog-target="add-index-dialog">+ Añadir índice</button>
        </div>
        <div class="table-wrap">
            <table class="market-table market-table-compact">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Símbolo</th>
                        <th class="text-align-right">Apertura</th>
                        <th class="text-align-right">CIERRE<br />(Anterior)</th>
                        <th class="text-align-right notranslate" translate="no">COTIZACIÓN ACTUAL</th>
                        <th class="text-align-right">Cambio %</th>
                        <th>Actualizado</th>
                        <th>Mercado<br />(abierto/cerrado)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tbody-indices">
                    @foreach (var item in Model.Indices)
                    {
                        <tr class="@(item.Symbol == "^STOXX50E" || item.Symbol == "^GSPC" ? "row-divider-bottom" : "")">
                            <td class="name-cell">
                                <span class="name-with-flag">
                                    <img class="flag-badge" src="@item.FlagUrl" alt="@item.CountryCode" title="@item.CountryCode" />
                                    <a class="name-link" href="/Historico?symbol=@item.Symbol&name=@item.Name">@item.Name</a>
                                </span>
                            </td>
                            <td>@item.DisplaySymbol</td>
                            <td class="price-cell price-cell-quote text-align-right">@item.DisplayOpen</td>
                            <td class="price-cell price-cell-quote text-align-right">@item.DisplayPreviousClose</td>
                            <td class="price-cell price-cell-quote">@item.DisplayPrice</td>
                            <td class="@item.TrendCssClass">@item.DisplayPercent</td>
                            <td class="time-cell">@item.UpdatedText</td>
                            <td class="market-status-cell market-status-cell-left">
                                <span class="market-status-dot @(item.IsMarketOpen ? "market-open" : "market-closed")" title="@item.MarketStatusLabel"></span>
                            </td>
                            <td class="delete-cell">
                                <form method="post" asp-page-handler="DeleteIndex" onsubmit="return confirm('¿Eliminar este índice?');">
                                    <input type="hidden" name="symbol" value="@item.Symbol" />
                                    <button type="submit" class="icon-button-delete" title="Eliminar">✕</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <dialog id="add-index-dialog" class="add-entry-dialog">
        <form method="post" asp-page-handler="AddIndex">
            <h3>Añadir índice</h3>
            <label>
                Nombre
                <input type="text" name="name" required maxlength="100" placeholder="Ej. FTSE 100" />
            </label>
            <label>
                Símbolo (Yahoo Finance)
                <input type="text" name="symbol" required maxlength="20" placeholder="Ej. ^FTSE" />
            </label>
            <label>
                País (código, opcional)
                <input type="text" name="countryCode" maxlength="2" placeholder="Ej. GB" />
            </label>
            <div class="dialog-actions">
                <button type="submit" formmethod="dialog" formnovalidate class="mini-button mini-button-secondary">Cancelar</button>
                <button type="submit" class="mini-button">Añadir</button>
            </div>
        </form>
    </dialog>

    <div class="market-panel mt-4">
        <div class="panel-head panel-head-row">
            <span>Acciones <span class="panel-head-subtitle">(Control de cotizaciones)</span></span>
            <button type="button" class="mini-button" data-dialog-target="add-stock-dialog">+ Añadir acción</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.StockError))
        {
            <div class="form-error-banner">@Model.StockError</div>
        }
        <div class="table-wrap">
            <table class="market-table market-table-compact">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Símbolo</th>
                        <th>Bolsa</th>
                        <th class="text-align-right">Apertura</th>
                        <th class="text-align-right">CIERRE<br />(Anterior)</th>
                        <th class="text-align-right notranslate" translate="no">COTIZACIÓN ACTUAL</th>
                        <th class="text-align-right">Cambio %</th>
                        <th>Actualizado</th>
                        <th>Mercado<br />(abierto/cerrado)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tbody-stocks">
                    @if (Model.Stocks.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="empty-state-cell">No hay acciones añadidas. Usa "+ Añadir acción" para empezar.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Stocks)
                        {
                            <tr>
                                <td class="name-cell">
                                    <span class="name-with-flag">
                                        <img class="flag-badge" src="@item.FlagUrl" alt="@item.CountryCode" title="@item.CountryCode" />
                                        <a class="name-link" href="/Historico?symbol=@item.Symbol&name=@item.Name">@item.Name</a>
                                    </span>
                                </td>
                                <td>@item.Symbol</td>
                                <td class="isin-cell">@item.DisplayMarket</td>
                                <td class="price-cell price-cell-quote text-align-right">@item.DisplayOpen €</td>
                                <td class="price-cell price-cell-quote text-align-right">@item.DisplayPreviousClose €</td>
                                <td class="price-cell price-cell-quote">@item.DisplayPrice €</td>
                                <td class="@item.TrendCssClass">@item.DisplayPercent</td>
                                <td class="time-cell">@item.UpdatedText</td>
                                <td class="market-status-cell market-status-cell-left">
                                    <span class="market-status-dot @(item.IsMarketOpen ? "market-open" : "market-closed")" title="@item.MarketStatusLabel"></span>
                                </td>
                                <td class="delete-cell">
                                    <form method="post" asp-page-handler="DeleteStock" onsubmit="return confirm('¿Eliminar esta acción?');">
                                        <input type="hidden" name="symbol" value="@item.Symbol" />
                                        <button type="submit" class="icon-button-delete" title="Eliminar">✕</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <dialog id="add-stock-dialog" class="add-entry-dialog">
        <form method="post" asp-page-handler="AddStock">
            <h3>Añadir acción</h3>
            <label>
                Nombre
                <input type="text" name="name" required maxlength="100" placeholder="Ej. Apple Inc." />
            </label>
            <label>
                Mercado
                <select name="market">
                    <option value="IBEX35">IBEX-35</option>
                    <option value="CAC40">CAC 40</option>
                    <option value="DAX">DAX</option>
                    <option value="EUROSTOXX50">EURO STOXX 50</option>
                    <option value="DOWJONES">DOW JONES</option>
                    <option value="NASDAQ">NASDAQ</option>
                    <option value="SP500">S&amp;P 500</option>
                </select>
            </label>
            <p class="dialog-hint">El símbolo se busca automáticamente a partir del nombre, priorizando el mercado seleccionado.</p>
            <div class="dialog-actions">
                <button type="submit" formmethod="dialog" formnovalidate class="mini-button mini-button-secondary">Cancelar</button>
                <button type="submit" class="mini-button">Añadir</button>
            </div>
        </form>
    </dialog>

    <div class="market-panel mt-4">
        <div class="panel-head panel-head-row">
            <span>ETF <span class="panel-head-subtitle">(Control de cotizaciones)</span></span>
            <button type="button" class="mini-button" data-dialog-target="add-etf-control-dialog">+ Añadir ETF</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.EtfControlError))
        {
            <div class="form-error-banner">@Model.EtfControlError</div>
        }
        <div class="table-wrap">
            <table class="market-table market-table-compact">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>ISIN</th>
                        <th class="text-align-right">Apertura</th>
                        <th class="text-align-right">CIERRE<br />(Anterior)</th>
                        <th class="text-align-right notranslate" translate="no">COTIZACIÓN ACTUAL</th>
                        <th class="text-align-right">Cambio %</th>
                        <th>Actualizado</th>
                        <th>Mercado<br />(abierto/cerrado)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tbody-etfs-control">
                    @if (Model.EtfsControl.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="empty-state-cell">No hay ETF añadidos. Usa "+ Añadir ETF" para empezar.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.EtfsControl)
                        {
                            <tr>
                                <td class="name-cell">
                                    <span class="name-with-flag">
                                        <img class="flag-badge" src="@item.FlagUrl" alt="@item.CountryCode" title="@item.CountryCode" />
                                        <a class="name-link" href="/Historico?symbol=@item.Symbol&name=@item.Name">@item.Name</a>
                                    </span>
                                </td>
                                <td class="isin-cell">@item.DisplayIsin</td>
                                <td class="price-cell price-cell-quote text-align-right">@item.DisplayOpen</td>
                                <td class="price-cell price-cell-quote text-align-right">@item.DisplayPreviousClose</td>
                                <td class="price-cell price-cell-quote">@item.DisplayPrice</td>
                                <td class="@item.TrendCssClass">@item.DisplayPercent</td>
                                <td class="time-cell">@item.UpdatedText</td>
                                <td class="market-status-cell market-status-cell-left">
                                    <span class="market-status-dot @(item.IsMarketOpen ? "market-open" : "market-closed")" title="@item.MarketStatusLabel"></span>
                                </td>
                                <td class="delete-cell">
                                    <form method="post" asp-page-handler="DeleteEtfControl" onsubmit="return confirm('¿Eliminar este ETF?');">
                                        <input type="hidden" name="symbol" value="@item.Symbol" />
                                        <button type="submit" class="icon-button-delete" title="Eliminar">✕</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <dialog id="add-etf-control-dialog" class="add-entry-dialog">
        <form method="post" asp-page-handler="AddEtfControl">
            <h3>Añadir ETF</h3>
            <label>
                Código ISIN
                <input type="text" name="isin" required maxlength="20" placeholder="Ej. IE00B5BMR087" />
            </label>
            <p class="dialog-hint">El nombre, el símbolo y el país se buscan automáticamente a partir del ISIN.</p>
            <div class="dialog-actions">
                <button type="submit" formmethod="dialog" formnovalidate class="mini-button mini-button-secondary">Cancelar</button>
                <button type="submit" class="mini-button">Añadir</button>
            </div>
        </form>
    </dialog>

    <div class="market-panel mt-4 notranslate" translate="no">
        <div class="panel-head panel-head-row">
            <span>Materias primas <span class="panel-head-subtitle">(Control de cotizaciones)</span></span>
        </div>
        <div class="table-wrap">
            <table class="market-table market-table-compact">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th class="text-align-right">Último</th>
                        <th class="text-align-right">Máximo</th>
                        <th class="text-align-right">Mínimo</th>
                        <th class="text-align-right">Var.</th>
                        <th class="text-align-right">% Var.</th>
                        <th>Fecha/Hora</th>
                    </tr>
                </thead>
                <tbody id="tbody-commodities">
                    @foreach (var item in Model.Commodities)
                    {
                        <tr>
                            <td class="name-cell">
                                <span class="name-with-flag">
                                    <img class="flag-badge" src="@item.FlagUrl" alt="@item.CountryCode" title="@item.CountryCode" />
                                    <a class="name-link" href="/Historico?symbol=@item.Symbol&name=@item.Name">@item.Name</a>
                                </span>
                            </td>
                            <td class="price-cell price-cell-quote">@item.DisplayPrice $</td>
                            <td class="price-cell price-cell-quote">@item.DisplayHigh $</td>
                            <td class="price-cell price-cell-quote">@item.DisplayLow $</td>
                            <td class="@item.TrendCssClass">@item.DisplayChange $</td>
                            <td class="@item.TrendCssClass">@item.DisplayPercent</td>
                            <td class="time-cell">@item.UpdatedText</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="blank-lines-2"></div>

    <div class="summary-strip-label">
        <button type="button" class="btn-toggle-summary" data-toggle-target="summary-strip-ing" title="Mostrar/ocultar">Mostrar</button>
        <span class="broker-label-text">
            <img class="broker-logo" src="/images/brokers/ing.png" alt="ING Direct" title="ING Direct" /> <span translate="no" class="notranslate">INGDIRECT (Resumen total de las posiciones)</span>
        </span>
    </div>
    <div class="summary-strip is-collapsed" id="summary-strip-ing">
        <div class="summary-box">
            <span>Importe total invertido</span>
            <strong>@Model.IngPurchaseValue.ToString("#,##0.00 €")</strong>
        </div>
        <div class="summary-box gain">
            <span>Rentabilidad total</span>
            <strong>@Model.IngGainPercent.ToString("+#,##0.00;-#,##0.00;0.00")% (@Model.IngGainValue.ToString("+#,##0.00 €;-#,##0.00 €;0.00 €"))</strong>
        </div>
        <div class="summary-box">
            <span>Importe total</span>
            <strong>@((Model.IngPurchaseValue + Model.IngGainValue).ToString("#,##0.00 €"))</strong>
        </div>
    </div>

    <div class="summary-strip-label">
        <button type="button" class="btn-toggle-summary" data-toggle-target="summary-strip-tr" title="Mostrar/ocultar">Mostrar</button>
        <span class="broker-label-text">
            <img class="broker-logo" src="/images/brokers/traderepublic.png" alt="Trade Republic" title="Trade Republic" /> <span translate="no" class="notranslate">TRADE REPUBLIC (Resumen total de las posiciones)</span>
        </span>
    </div>
    <div class="summary-strip is-collapsed" id="summary-strip-tr">
        <div class="summary-box">
            <span>Importe total invertido</span>
            <strong>@Model.TrPurchaseValue.ToString("#,##0.00 €")</strong>
        </div>
        <div class="summary-box gain">
            <span>Rentabilidad total</span>
            <strong>@Model.TrGainPercent.ToString("+#,##0.00;-#,##0.00;0.00")% (@Model.TrGainValue.ToString("+#,##0.00 €;-#,##0.00 €;0.00 €"))</strong>
        </div>
        <div class="summary-box">
            <span>Importe total</span>
            <strong>@((Model.TrPurchaseValue + Model.TrGainValue).ToString("#,##0.00 €"))</strong>
        </div>
    </div>

    <div class="market-panel mt-4">
        <div class="panel-head panel-head-row">
            <span>ETF <span class="panel-head-subtitle">(Cartera)</span></span>
            <button type="button" class="mini-button" data-dialog-target="add-etf-dialog">+ Añadir ETF</button>
        </div>
        <div class="table-wrap">
            <table class="market-table">
                <thead>
                    <tr>
                        <th style="min-width: 260px;">Nombre</th>
                        <th>ISIN</th>
                        <th>Bróker</th>
                        <th class="text-align-right notranslate" translate="no">COTIZACIÓN ACTUAL</th>
                        <th class="text-align-right">Cambio %</th>
                        <th class="text-align-right">Títulos / Precio</th>
                        <th class="text-align-right">Valoración compra</th>
                        <th class="text-align-right">Valoración actual</th>
                        <th class="text-align-right">% Rentabilidad / Importe</th>
                        <th>Fecha/Hora Actualización</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tbody-etfs">
                    @if (Model.Etfs.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="empty-state-cell">No hay ETF añadidos. Usa "+ Añadir ETF" para empezar.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Etfs.OrderBy(e => Model.EtfHoldings.FirstOrDefault(h => h.Symbol == e.Symbol)?.Broker == "ING" ? 0 : 1))
                        {
                            var holding = Model.EtfHoldings.FirstOrDefault(h => h.Symbol == item.Symbol);
                            var currentPrice = item.Price ?? 0m;
                            var positionCount = holding?.PositionCount ?? 0m;
                            var purchaseDisplayValue = holding?.UnitPurchasePrice ?? 0m;
                            var purchaseValue = positionCount * purchaseDisplayValue;
                            var currentValue = currentPrice * positionCount;
                            var gainValue = currentValue - purchaseValue;
                            var gainPercent = purchaseValue == 0 ? 0m : (gainValue / purchaseValue) * 100m;
                            var isIngDirect = holding?.Broker == "ING";
                            var isTradeRepublic = holding?.Broker == "TR";

                            <tr class="@(item.Symbol == "UST.PA" ? "row-divider-bottom" : "")">
                                <td class="name-cell name-cell-regular">
                                    <span class="name-with-flag">
                                        <img class="flag-badge" src="@item.FlagUrl" alt="@item.CountryCode" title="@item.CountryCode" />
                                        <a class="name-link" href="/Historico?symbol=@item.Symbol&name=@item.Name">@item.Name</a>
                                    </span>
                                </td>
                                <td class="isin-cell">@item.DisplayIsin</td>
                                <td class="broker-cell">
                                    @if (isIngDirect)
                                    {
                                        <img class="broker-logo" src="/images/brokers/ing.png" alt="ING Direct" title="ING Direct" />
                                    }
                                    else if (isTradeRepublic)
                                    {
                                        <img class="broker-logo" src="/images/brokers/traderepublic.png" alt="Trade Republic" title="Trade Republic" />
                                    }
                                </td>
                                <td class="price-cell price-cell-quote">@currentPrice.ToString("#,##0.00 €")</td>
                                <td class="@item.TrendCssClass">@item.DisplayPercent</td>
                                <td class="purchase-cell">
                                    @positionCount.ToString("#,##0.######")<br />
                                    @purchaseDisplayValue.ToString("#,##0.00 €")
                                </td>
                                <td class="price-cell price-cell-quote">@purchaseValue.ToString("#,##0.00 €")</td>
                                <td class="price-cell price-cell-quote">@currentValue.ToString("#,##0.00 €")</td>
                                <td class="@((gainPercent >= 0 ? "text-success" : "text-danger"))">@gainPercent.ToString("+#,##0.00;-#,##0.00;0.00")% @(gainPercent >= 0 ? "▲" : "▼")<br />@gainValue.ToString("+#,##0.00 €;-#,##0.00 €;0.00 €")</td>
                                <td class="time-cell">@item.UpdatedText</td>
                                <td class="delete-cell">
                                    <button type="button" class="icon-button-edit" data-dialog-target="edit-etf-@item.Symbol" title="Editar">✎</button>
                                    <form method="post" asp-page-handler="DeleteEtf" onsubmit="return confirm('¿Eliminar este ETF?');">
                                        <input type="hidden" name="symbol" value="@item.Symbol" />
                                        <button type="submit" class="icon-button-delete" title="Eliminar">✕</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @foreach (var item in Model.Etfs)
    {
        var etfHolding = Model.EtfHoldings.FirstOrDefault(h => h.Symbol == item.Symbol);
        var etfPositionCount = etfHolding?.PositionCount ?? 0m;
        var etfPurchaseDisplayValue = etfHolding?.UnitPurchasePrice ?? 0m;
        var etfIsIngDirect = etfHolding?.Broker == "ING";
        var etfIsTradeRepublic = etfHolding?.Broker == "TR";

        <dialog id="edit-etf-@item.Symbol" class="add-entry-dialog">
            <form method="post" asp-page-handler="EditEtf">
                <h3>Editar @item.Name</h3>
                <input type="hidden" name="symbol" value="@item.Symbol" />
                <label>
                    Bróker
                    <select name="broker" required>
                        <option value="ING" selected="@(etfIsIngDirect)">ING Direct</option>
                        <option value="TR" selected="@(etfIsTradeRepublic)">Trade Republic</option>
                    </select>
                </label>
                <label>
                    Número de títulos
