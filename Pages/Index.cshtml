        <div id="capital-panel-body" class="hacienda-panel-body transaction-broker-grid is-collapsed">
            <div class="transaction-broker-card">
                <div class="transaction-broker-header"><div class="transaction-broker-name"><span>Rendimientos del capital mobiliario a integrar en la base imponible del ahorro · DECLARANTE</span></div></div>
                <form method="post" asp-page-handler="SaveCapital">
                    <div class="table-wrap">
                        <table class="market-table market-table-grid transaction-table">
                            <thead>
                                <tr>
                                    <th>Casilla</th>
                                    <th>Concepto</th>
                                    <th class="text-align-right">Importe (€)</th>
                                </tr>
