                <input type="number" name="positionCount" required min="0.000001" step="0.000001" placeholder="Ej. 10" />
            </label>
            <label>
                Precio de compra (unitario)
                <input type="number" name="unitPurchasePrice" required min="0.01" step="0.01" placeholder="Ej. 150.00" />
            </label>
            <label>
                Mercado
                <select name="market">
                    <option value="IBEX35">IBEX-35</option>
                    <option value="CAC40">CAC 40</option>
                    <option value="DAX">DAX</option>
                    <option value="EUROSTOXX50">EURO STOXX 50</option>
                    <option value="DOWJONES">DOW JONES</option>
                    <option value="NASDAQ">NASDAQ</option>
                    <option value="SP500">S&amp;P 500</option>
                </select>
            </label>
            <label>
                Bróker
                <select name="broker" required>
                    <option value="ING">ING Direct</option>
                    <option value="TR">Trade Republic</option>
                </select>
            </label>
            <p class="dialog-hint">El símbolo se busca automáticamente a partir del nombre, priorizando el mercado seleccionado.</p>
            <div class="dialog-actions">
                <button type="submit" formmethod="dialog" formnovalidate class="mini-button mini-button-secondary">Cancelar</button>
                <button type="submit" class="mini-button">Añadir</button>
            </div>
        </form>
    </dialog>
</div>

@section Scripts {
    <script>
        (function () {
            var refreshIntervalMs = 15000;
            var idsAActualizar = [
                'summary-strip',
                'summary-strip-ing',
                'summary-strip-tr',
                'tbody-indices',
                'tbody-stocks',
                'tbody-etfs-control',
                'tbody-commodities',
                'tbody-etfs',
                'tbody-funds',
                'tbody-pensionplans',
                'tbody-portfolio-stocks'
            ];

            function actualizarDatos() {
                var hayDialogoAbierto = document.querySelector('dialog[open]') !== null;
                if (hayDialogoAbierto) {
                    return Promise.resolve();
                }

                return fetch(window.location.href, { cache: 'no-store' })
                    .then(function (respuesta) { return respuesta.text(); })
                    .then(function (html) {
                        var parser = new DOMParser();
                        var docNuevo = parser.parseFromString(html, 'text/html');

                        idsAActualizar.forEach(function (id) {
                            var actual = document.getElementById(id);
                            var nuevo = docNuevo.getElementById(id);
                            if (actual && nuevo) {
                                actual.innerHTML = nuevo.innerHTML;
                            }
                        });
                    })
                    .catch(function () {
                        // Si falla la petición (red, servidor dormido, etc.) simplemente se reintenta en el siguiente ciclo.
                    });
            }

            setInterval(actualizarDatos, refreshIntervalMs);
            window.refreshPageData = actualizarDatos;
        })();
    </script>
}
