                            }
                            @foreach (var s in summaryRows)
                            {
                                <tr>
                                    <td><span class="transaction-title-isin">@(string.IsNullOrWhiteSpace(s.Isin) ? "—" : s.Isin)</span>@if (!string.IsNullOrWhiteSpace(s.Nombre)) {<br /><span class="transaction-title-name">@s.Nombre</span>}</td>
                                    <td class="text-align-right">@s.BuyShares.ToString("#,##0.######", esCulture)</td>
                                    <td class="text-align-right">@s.BuyAmount.ToString("#,##0.00 €", esCulture)</td>
                                    <td class="text-align-right">@s.SellShares.ToString("#,##0.######", esCulture)</td>
                                    <td class="text-align-right">@s.SellAmount.ToString("#,##0.00 €", esCulture)</td>
                                    <td class="text-align-right price-cell @(s.Result >= 0 ? "hacienda-gain" : "hacienda-loss")">@s.Result.ToString("+#,##0.00 €;-#,##0.00 €;0.00 €", esCulture)</td>
                                    <td class="text-align-right">@(s.Held == 0 ? "Regularizado" : s.Held.ToString("#,##0.######", esCulture) + " títulos")</td>
                                </tr>
                            }
                        </tbody>
                        @if (summaryRows.Count > 0)
                        {
                            <tfoot>
                                <tr>
                                    <td><strong>Total</strong></td>
                                    <td class="text-align-right"><strong>@summaryRows.Sum(s => s.BuyShares).ToString("#,##0.######", esCulture)</strong></td>
                                    <td class="text-align-right"><strong>@summaryRows.Sum(s => s.BuyAmount).ToString("#,##0.00 €", esCulture)</strong></td>
                                    <td class="text-align-right"><strong>@summaryRows.Sum(s => s.SellShares).ToString("#,##0.######", esCulture)</strong></td>
                                    <td class="text-align-right"><strong>@summaryRows.Sum(s => s.SellAmount).ToString("#,##0.00 €", esCulture)</strong></td>
                                    <td class="text-align-right price-cell @(summaryResultTotal >= 0 ? "hacienda-gain" : "hacienda-loss")"><strong>@summaryResultTotal.ToString("+#,##0.00 €;-#,##0.00 €;0.00 €", esCulture)</strong></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
                <div class="hacienda-notices-note">Resultado = importe de ventas − importe de compras. Si un título aún tiene títulos en cartera, el resultado es parcial (aún no está regularizado).</div>
            </div>
        </div>
    </div>

