                            @foreach (var s in hac.Sales)
                            {
                                <tr>
                                    <td><span class="transaction-title-isin">@(string.IsNullOrWhiteSpace(s.Isin) ? "—" : s.Isin)</span><br /><span class="transaction-title-name">@s.Label</span></td>
                                    <td class="text-align-right">@s.Date.ToString("dd/MM/yyyy")</td>
                                    <td class="text-align-right">@s.Shares.ToString("#,##0.######", esCulture)@(s.UnmatchedShares > 0 ? " (sin compra: " + s.UnmatchedShares.ToString("#,##0.######", esCulture) + ")" : "")</td>
                                    <td class="text-align-right">@s.Proceeds.ToString(eurPlain, esCulture)</td>
                                    <td class="text-align-right">@s.Cost.ToString(eurPlain, esCulture)</td>
                                    <td class="text-align-right price-cell @(s.Gain >= 0 ? "hacienda-gain" : "hacienda-loss")">@s.Gain.ToString(eurSigned, esCulture)</td>
                                    <td class="text-align-right price-cell">@s.Computable.ToString(eurSigned, esCulture)@(s.Gain < 0 && s.DeferredLoss > 0 ? " (diferida " + s.DeferredLoss.ToString(eurPlain, esCulture) + ")" : "")</td>
                                </tr>
                                foreach (var lot in s.Lots)
                                {
                                    <tr class="hacienda-lot-row">
                                        <td>• Compra que se descuenta (FIFO)</td>
                                        <td class="text-align-right">@lot.Date.ToString("dd/MM/yyyy")</td>
                                        <td class="text-align-right">@lot.SharesUsed.ToString("#,##0.######", esCulture)@(lot.SharesUsed < lot.SharesBought ? " de " + lot.SharesBought.ToString("#,##0.######", esCulture) : "")</td>
                                        <td></td>
                                        <td class="text-align-right">@lot.Cost.ToString(eurPlain, esCulture)</td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                                foreach (var wp in s.WindowPurchases)
                                {
                                    <tr class="hacienda-lot-row hacienda-lot-row-warn">
                                        <td>• Recompra en ±@(s.WashMonths == 12 ? "1 año" : s.WashMonths + " meses") de la venta con pérdida (puede diferirla)</td>
