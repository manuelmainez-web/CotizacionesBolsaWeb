                Código DGSFP
                <input type="text" name="codigoDgsfp" maxlength="50" placeholder="Ej. N3901 / F1399" />
            </label>
            <label>
                Valor liquidativo <span class="panel-head-subtitle">(opcional, se calcula dinámicamente)</span>
                <input type="text" name="valorLiquidativo" inputmode="decimal" pattern="[0-9.,]+" min="0.01" step="0.01" placeholder="Ej. 12.50" />
            </label>
            <label>
                Capital invertido
                <input type="text" name="capitalInvertido" inputmode="decimal" pattern="[0-9.,]+" step="0.01" placeholder="Ej. 27484.40" />
            </label>
            <div class="dialog-actions">
                <button type="submit" formmethod="dialog" formnovalidate class="mini-button mini-button-secondary">Cancelar</button>
                <button type="submit" class="mini-button">Añadir</button>
