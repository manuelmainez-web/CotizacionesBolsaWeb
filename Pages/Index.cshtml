    <div class="market-panel hacienda-panel mt-4">
        <div class="panel-head panel-head-row">
            <span>
                <button type="button" class="btn-toggle-summary table-toggle-button toggle-left" data-toggle-target="capital-panel-body" data-toggle-name="hacienda-capital" title="Mostrar/ocultar" aria-label="Mostrar capital mobiliario" aria-expanded="false"></button>
                <img class="transaction-broker-logo panel-header-logo" src="/images/brokers/aeat.png" style="border-radius: 6px; background: #fff;" alt="Agencia Tributaria" title="Agencia Tributaria" />
