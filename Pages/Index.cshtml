                                                    <th>Tipo operación</th>
                                                    <th class="text-align-right">N.º títulos</th>
                                                    <th class="text-align-right">Importe total</th>
                                                    <th class="text-align-right">Fecha de la operación</th>
                                                    <th style="width: 96px;"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in paneGroup.Rows)
                                                {
                                                    <tr class="@(row.FechaOperacion.Year == DateTime.Now.Year ? "transaction-row-current-year" : "")">
                                                        <td><span class="transaction-title-isin">@(string.IsNullOrWhiteSpace(paneGroup.Isin) ? "—" : paneGroup.Isin)</span>@if (!string.IsNullOrWhiteSpace(paneGroup.Nombre)) {<br /><span class="transaction-title-name">@paneGroup.Nombre</span>}</td>
                                                        <td>@row.TipoOperacion</td>
                                                        <td class="text-align-right">@row.NumeroTitulos.ToString("#,##0.######", esCulture)</td>
                                                        <td class="text-align-right price-cell">@((kind.Sign * Math.Abs(row.ImporteTotal)).ToString("+#,##0.00 €;-#,##0.00 €;0.00 €", esCulture))</td>
                                                        <td class="text-align-right">@row.FechaOperacion.ToString("dd/MM/yyyy")</td>
                                                        <td class="delete-cell">
                                                            <button type="button" class="icon-button-edit" data-dialog-target="edit-excel-tx-@row.Id" title="Editar">✎</button>
                                                            <form method="post" asp-page-handler="DeleteExcelTransaction" onsubmit="return confirm('¿Eliminar este movimiento?');">
                                                                <input type="hidden" name="id" value="@row.Id" />
                                                                <button type="submit" class="icon-button-delete" title="Eliminar">✕</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @{
        var summaryRows = Model.ExcelTransactions
            .GroupBy(r =>
            {
                var parts = Model.GetTransactionTitleParts(r);
                return string.IsNullOrWhiteSpace(parts.Isin) ? "t:" + parts.Nombre.Trim().ToLowerInvariant() : "i:" + parts.Isin;
            })
            .Select(g =>
            {
                var parts = Model.GetTransactionTitleParts(g.First());
                var buys = g.Where(r => !(r.TipoOperacion != null && r.TipoOperacion.StartsWith("VEN", StringComparison.OrdinalIgnoreCase))).ToList();
                var sells = g.Where(r => r.TipoOperacion != null && r.TipoOperacion.StartsWith("VEN", StringComparison.OrdinalIgnoreCase)).ToList();
                var buyAmount = buys.Sum(r => Math.Abs(r.ImporteTotal));
                var sellAmount = sells.Sum(r => Math.Abs(r.ImporteTotal));
                var buyShares = buys.Sum(r => r.NumeroTitulos);
                var sellShares = sells.Sum(r => r.NumeroTitulos);
                return new
                {
                    Isin = parts.Isin,
                    Nombre = parts.Nombre,
                    Label = string.IsNullOrWhiteSpace(parts.Nombre) ? parts.Isin : parts.Nombre,
                    BuyShares = buyShares,
                    BuyAmount = buyAmount,
                    SellShares = sellShares,
                    SellAmount = sellAmount,
                    Result = sellAmount - buyAmount,
                    Held = buyShares - sellShares
                };
            })
            .OrderBy(s => s.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();
        var summaryResultTotal = summaryRows.Sum(s => s.Result);
    }
    <div class="market-panel ing-panel mt-4">
        <div class="panel-head panel-head-row">
            <span>
                <button type="button" class="btn-toggle-summary table-toggle-button toggle-left" data-toggle-target="title-summary-panel-body" data-toggle-name="resumen por título" title="Mostrar/ocultar" aria-label="Mostrar resumen por título" aria-expanded="false"></button>
