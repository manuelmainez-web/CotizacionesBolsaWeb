@page
@model CotizacionesBolsaWeb.Pages.IndexModel
@{
    ViewData["Title"] = "Cotizaciones bolsa";
}

<div class="market-shell" id="market-shell">
    <div class="print-broker-letterhead print-broker-letterhead-ing">
        <p class="print-broker-letterhead-title">Cartera de Valores</p>
        <div class="print-broker-letterhead-top">
            <img class="print-broker-letterhead-avatar" src="/images/avatar-manuel.jpg" alt="Manuel Máinez Arrojo" />
            <div class="print-broker-letterhead-info">
                <p class="print-broker-letterhead-name">Manuel Máinez Arrojo</p>
                <p class="print-broker-letterhead-datetime" id="print-datetime-ing"></p>
            </div>
        </div>
        <img class="print-broker-letterhead-logo" src="/images/brokers/ing-direct-logo.png" alt="ING Direct" />
    </div>
    <div class="print-broker-letterhead print-broker-letterhead-tr">
        <p class="print-broker-letterhead-title">Cartera de Valores</p>
        <div class="print-broker-letterhead-top">
            <img class="print-broker-letterhead-avatar" src="/images/avatar-manuel.jpg" alt="Manuel Máinez Arrojo" />
            <div class="print-broker-letterhead-info">
                <p class="print-broker-letterhead-name">Manuel Máinez Arrojo</p>
                <p class="print-broker-letterhead-datetime" id="print-datetime-tr"></p>
            </div>
        </div>
        <img class="print-broker-letterhead-logo" src="/images/brokers/logotipo-trade-republic.png" alt="Trade Republic" />
    </div>
    <div class="print-broker-letterhead print-cartera-letterhead">
        <p class="print-cartera-letterhead-title">Cartera de Valores</p>
        <div class="print-broker-letterhead-top">
            <img class="print-broker-letterhead-avatar" src="/images/avatar-manuel.jpg" alt="Manuel Máinez Arrojo" />
            <div class="print-broker-letterhead-info">
                <p class="print-broker-letterhead-name">Manuel Máinez Arrojo</p>
            </div>
        </div>
        <p class="print-broker-letterhead-datetime" id="print-datetime-cartera"></p>
    </div>
    <div class="portfolio-header">
        <div class="title-block">
            <img class="portfolio-header-image" src="/images/portfolio-header.jpg" alt="Cabecera cartera" />
            <p class="print-all-title">Cotizaciones y Cartera de Valores</p>
            <h1 class="mb-1">
                <span class="portfolio-name-row">
                    <img class="portfolio-avatar" src="/images/avatar-manuel.jpg" alt="Manuel Máinez Arrojo" />
                    <span class="portfolio-name-text">Manuel Máinez Arrojo</span>
                </span>
            </h1>
            <p class="portfolio-subtitle">Siga de cerca sus instrumentos financieros y el rendimiento de sus posiciones.</p>
            <p class="portfolio-note">• Para arrancar la página de cotizaciones bastará con escanear el código QR.</p>
            <p class="portfolio-note portfolio-note-tight">• Las cotizaciones se actualizan cada 15 segundos con un desfase de 15 o 20 minutos.</p>
            <p class="print-only" id="print-datetime"></p>
            <div class="blank-line-1"></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.PublicUrl))
        {
            <div class="qr-box">
                <img class="qr-image" src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=@Uri.EscapeDataString(Model.PublicUrl)" alt="Código QR de acceso" />
                <span class="qr-label">Escanea para abrir<br />desde el móvil</span>
            </div>
        }
    </div>

    <div class="quick-links-panel">
        <div class="quick-links" translate="no">
            <a class="mini-button quick-link-button notranslate" translate="no" href="https://es.investing.com/indices/major-indices" target="_blank" rel="noopener noreferrer">
                <img class="quick-link-icon" src="/images/brokers/investing.png" alt="Investing" />
                <span translate="no" class="notranslate">Investing</span>
            </a>
            <a class="mini-button quick-link-button notranslate" translate="no" href="https://ing.ingdirect.es/app-login/" target="_blank" rel="noopener noreferrer">
                <img class="quick-link-icon" src="/images/brokers/ing.png" alt="Ingdirect" />
                <span translate="no" class="notranslate">Ingdirect</span>
            </a>
            <a class="mini-button quick-link-button notranslate" translate="no" href="https://app.traderepublic.com/" target="_blank" rel="noopener noreferrer">
                <img class="quick-link-icon" src="/images/brokers/traderepublic.png" alt="Trade Republic" />
                <span translate="no" class="notranslate">Trade Republic</span>
            </a>
            <a class="mini-button quick-link-button notranslate" translate="no" href="https://www.google.com/search?q=por+que+ha+subido+o+bajado+la+bolsa+en+la+jornada+actual&tbm=nws" target="_blank" rel="noopener noreferrer">
                <span aria-hidden="true">📰</span>
                <span translate="no" class="notranslate">Noticias</span>
            </a>
        </div>
    </div>

    <div class="summary-panel">
        <div class="summary-strip-label" id="summary-strip-label-general">
            <button type="button" class="btn-toggle-summary" data-toggle-target="summary-strip-general" data-toggle-name="resumen general" title="Mostrar/ocultar">Mostrar</button>
            <span class="summary-general-label-text">RESUMEN IMPORTE TOTAL</span>
            <div class="print-actions" id="print-actions">
                <button type="button" class="mini-button quick-link-button" id="btn-print-cartera" title="Imprime solo la cartera, cuenta corriente y efectivo con las casillas de resumen">
                    <span>🖨️ Imprimir cartera</span>
                </button>
                <button type="button" class="mini-button quick-link-button" id="btn-print-page" title="Imprime toda la página">
                    <span>🖨️ Imprimir todo</span>
                </button>
            </div>
        </div>
        <div class="summary-strip is-collapsed" id="summary-strip-general">
            <div class="summary-box">
                <div class="summary-total-header">
                    <span class="summary-total-main">IMPORTE TOTAL</span>
                    <span class="summary-total-detail">(Importe total de las posiciones + importe total cuenta corriente + importe efectivo)</span>
                </div>
                <strong>@Model.TotalGeneralConCuentasYEfectivo.ToString("#,##0.00 €")</strong>
                <div class="summary-breakdown">
                    @Model.PositionsCurrentValue.ToString("#,##0.00 €") + @Model.CheckingAccountsTotalValue.ToString("#,##0.00 €") + @Model.CashTotalValue.ToString("#,##0.00 €")
                </div>
            </div>
        </div>

        <div class="summary-strip-label" id="summary-strip-label">
            <button type="button" class="btn-toggle-summary" data-toggle-target="summary-strip" data-toggle-name="resumen total" title="Mostrar/ocultar">Mostrar</button>
            RESUMEN TOTAL DE LAS POSICIONES
        </div>
        <div class="summary-strip is-collapsed" id="summary-strip">
            <div class="summary-box invested">
                <span>Importe total invertido</span>
                <strong>@Model.TotalPurchaseValue.ToString("#,##0.00 €")</strong>
            </div>
            <div class="summary-box gain">
                <span>Rentabilidad total</span>
                <strong>@Model.TotalGainPercent.ToString("+#,##0.00;-#,##0.00;0.00")% (@Model.TotalGainValue.ToString("+#,##0.00 €;-#,##0.00 €;0.00 €"))</strong>
            </div>
            <div class="summary-box @(Model.TotalGainValue >= 0 ? "gain" : "loss")">
                <span>Importe total</span>
                <strong>@((Model.TotalPurchaseValue + Model.TotalGainValue).ToString("#,##0.00 €"))</strong>
            </div>
        </div>
    </div>

    <div class="blank-line-1"></div>

    <div class="market-panel market-panel-watchlist">
        <div class="panel-head panel-head-row">
            <span>Índices <span class="panel-head-subtitle">(Control de cotizaciones)</span></span>
            <button type="button" class="mini-button" data-dialog-target="add-index-dialog">+ Añadir índice</button>
        </div>
        <div class="table-wrap">
            <table class="market-table market-table-compact market-table-grid" style="table-layout: fixed;">
                <thead>
                    <tr>
                        <th style="width: 180px;">Nombre</th>
                        <th class="text-align-right" style="width: 70px;">Cambio</th>
                        <th class="text-align-right notranslate" translate="no" style="width: 90px;">COTIZACIÓN ACTUAL</th>
                        <th class="text-align-right" style="width: 90px;">Apertura</th>
                        <th class="text-align-right" style="width: 90px;">CIERRE<br />(Anterior)</th>
                        <th class="text-align-right" style="width: 100px;">Volumen</th>
                        <th class="text-align-right" style="width: 110px;">Actualizado</th>
                        <th class="text-align-right" style="width: 90px;">Símbolo</th>
                        <th style="width: 96px;"></th>
                    </tr>
                </thead>
                <tbody id="tbody-indices">
                    @for (var indexRow = 0; indexRow < Model.Indices.Count; indexRow++)
                    {
                        var item = Model.Indices[indexRow];
                        var isLastOfRegion = indexRow < Model.Indices.Count - 1
                            && Model.GetIndexRegionOrder(item.CountryCode) != Model.GetIndexRegionOrder(Model.Indices[indexRow + 1].CountryCode);
                        var esVix = string.Equals(item.Symbol, "^VIX", StringComparison.OrdinalIgnoreCase);
                        <tr class="@(isLastOfRegion ? "row-divider-bottom" : "") @(esVix ? "row-highlight-vix" : "")">
                            <td class="name-cell">
                                <span class="name-with-flag">
                                    <img class="flag-badge" src="@item.FlagUrl" alt="@item.CountryCode" title="@item.CountryCode" />
                                    <a class="name-link" href="/Historico?symbol=@item.Symbol&name=@item.Name&countryCode=@item.CountryCode">@item.Name</a>
                                </span>
                            </td>
                            <td class="@item.TrendCssClass">@item.DisplayPercent</td>
                            <td class="price-cell price-cell-quote">@item.DisplayPrice</td>
                            <td class="price-cell price-cell-quote text-align-right">@item.DisplayOpen</td>
                            <td class="price-cell price-cell-quote text-align-right">@item.DisplayPreviousClose</td>
                            <td class="text-align-right">@item.DisplayVolume</td>
                            <td class="time-cell">
                                @item.UpdatedText
                                <span class="market-clock @(item.IsMarketOpen ? "market-open" : "market-closed")" title="@item.MarketStatusLabel" aria-label="@item.MarketStatusLabel">
                                    <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true" focusable="false">
                                        <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                                        <path d="M8 4.3v4l2.6 2.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </span>
                            </td>
                            <td class="text-align-right">@item.DisplaySymbol</td>
                            <td class="delete-cell">
                                <form method="post" asp-page-handler="MoveIndexUp" class="inline-form">
                                    <input type="hidden" name="symbol" value="@item.Symbol" />
                                    <button type="submit" class="icon-button-move" title="Subir" @(indexRow == 0 ? "disabled" : "")>▲</button>
                                </form>
                                <form method="post" asp-page-handler="MoveIndexDown" class="inline-form">
                                    <input type="hidden" name="symbol" value="@item.Symbol" />
                                    <button type="submit" class="icon-button-move" title="Bajar" @(indexRow == Model.Indices.Count - 1 ? "disabled" : "")>▼</button>
                                </form>
                                <form method="post" asp-page-handler="DeleteIndex" onsubmit="return confirm('¿Eliminar este índice?');">
                                    <input type="hidden" name="symbol" value="@item.Symbol" />
                                    <button type="submit" class="icon-button-delete" title="Eliminar">✕</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <dialog id="add-index-dialog" class="add-entry-dialog">
        <form method="post" asp-page-handler="AddIndex">
            <h3>Añadir índice</h3>
            <label>
                País
                <select id="add-index-country" required>
                    <option value="" selected disabled>Selecciona un país</option>
                </select>
            </label>
            <label>
                Índice
                <select id="add-index-select" required disabled>
                    <option value="" selected disabled>Selecciona primero un país</option>
                </select>
            </label>
            <input type="hidden" name="name" id="add-index-name-hidden" />
            <input type="hidden" name="symbol" id="add-index-symbol-hidden" />
            <input type="hidden" name="countryCode" id="add-index-country-hidden" />
            <div class="dialog-actions">
                <button type="submit" formmethod="dialog" formnovalidate class="mini-button mini-button-secondary">Cancelar</button>
                <button type="submit" class="mini-button" id="add-index-submit" disabled>Añadir</button>
            </div>
        </form>
    </dialog>

    <div class="market-panel mt-4 market-panel-watchlist">
        <div class="panel-head panel-head-row">
            <span>Futuros <span class="panel-head-subtitle">(Control de cotizaciones)</span></span>
        </div>
        <div class="table-wrap">
            <table class="market-table market-table-compact market-table-grid" style="table-layout: fixed;">
                <thead>
                    <tr>
                        <th style="width: 180px;">Nombre</th>
                        <th class="text-align-right" style="width: 70px;">Cambio</th>
                        <th class="text-align-right notranslate" translate="no" style="width: 90px;">COTIZACIÓN ACTUAL</th>
                        <th class="text-align-right" style="width: 90px;">Apertura</th>
                        <th class="text-align-right" style="width: 90px;">CIERRE<br />(Anterior)</th>
                        <th class="text-align-right" style="width: 100px;">Volumen</th>
                        <th class="text-align-right" style="width: 110px;">Actualizado</th>
                        <th class="text-align-right" style="width: 90px;">Símbolo</th>
                        <th style="width: 96px;"></th>
                    </tr>
                </thead>
                <tbody id="tbody-futures">
                    @if (Model.Futures.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="empty-state-cell">No hay futuros disponibles para mostrar.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Futures)
                        {
                            <tr>
                                <td class="name-cell">
                                    <span class="name-with-flag">
                                        <img class="flag-badge" src="@item.FlagUrl" alt="@item.CountryCode" title="@item.CountryCode" />
                                        <a class="name-link" href="/Historico?symbol=@item.Symbol&name=@item.Name&countryCode=@item.CountryCode">@item.Name</a>
                                    </span>
                                </td>
                                <td class="@item.TrendCssClass">@item.DisplayPercent</td>
                                <td class="price-cell price-cell-quote">@item.DisplayPrice</td>
                                <td class="price-cell price-cell-quote text-align-right">@item.DisplayOpen</td>
                                <td class="price-cell price-cell-quote text-align-right">@item.DisplayPreviousClose</td>
                                <td class="text-align-right">@item.DisplayVolume</td>
                                <td class="time-cell">
                                    @item.UpdatedText
                                    <span class="market-clock @(item.IsMarketOpen ? "market-open" : "market-closed")" title="@item.MarketStatusLabel" aria-label="@item.MarketStatusLabel">
                                        <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true" focusable="false">
                                            <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                                            <path d="M8 4.3v4l2.6 2.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                </td>
                                <td class="text-align-right">@item.DisplaySymbol</td>
                                <td class="delete-cell"></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="market-panel mt-4 market-panel-watchlist">
        <div class="panel-head panel-head-row">
            <span>Acciones <span class="panel-head-subtitle">(Control de cotizaciones)</span></span>
            <button type="button" class="mini-button" data-dialog-target="add-stock-dialog">+ Añadir acción</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.StockError))
        {
            <div class="form-error-banner">@Model.StockError</div>
        }
        <div class="table-wrap">
            <table class="market-table market-table-compact market-table-grid" style="table-layout: fixed;">
                <thead>
                    <tr>
                        <th style="width: 180px;">Nombre</th>
                        <th class="text-align-right" style="width: 70px;">Cambio</th>
                        <th class="text-align-right notranslate" translate="no" style="width: 90px;">COTIZACIÓN ACTUAL</th>
                        <th class="text-align-right" style="width: 90px;">Apertura</th>
                        <th class="text-align-right" style="width: 90px;">CIERRE<br />(Anterior)</th>
                        <th class="text-align-right" style="width: 100px;">Volumen</th>
                        <th class="text-align-right" style="width: 110px;">Actualizado</th>
                        <th class="text-align-right" style="width: 90px;">Símbolo</th>
                        <th style="width: 96px;"></th>
                    </tr>
                </thead>
                <tbody id="tbody-stocks">
                    @if (Model.Stocks.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="empty-state-cell">No hay acciones añadidas. Usa "+ Añadir acción" para empezar.</td>
                        </tr>
                    }
                    else
                    {
                        @for (var stockRow = 0; stockRow < Model.Stocks.Count; stockRow++)
                        {
                            var item = Model.Stocks[stockRow];
                            <tr>
                                <td class="name-cell">
                                    <span class="name-with-flag">
                                        <img class="flag-badge" src="@item.FlagUrl" alt="@item.CountryCode" title="@item.CountryCode" />
                                        <a class="name-link" href="/Historico?symbol=@item.Symbol&name=@item.Name&countryCode=@item.CountryCode">@item.Name</a>
                                    </span>
                                </td>
                                <td class="@item.TrendCssClass">@item.DisplayPercent</td>
                                <td class="price-cell price-cell-quote">@item.DisplayPrice €</td>
                                <td class="price-cell price-cell-quote text-align-right">@item.DisplayOpen €</td>
                                <td class="price-cell price-cell-quote text-align-right">@item.DisplayPreviousClose €</td>
                                <td class="text-align-right">@item.DisplayVolume</td>
                                <td class="time-cell">
                                    @item.UpdatedText
                                    <span class="market-clock @(item.IsMarketOpen ? "market-open" : "market-closed")" title="@item.MarketStatusLabel" aria-label="@item.MarketStatusLabel">
                                        <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true" focusable="false">
                                            <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                                            <path d="M8 4.3v4l2.6 2.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                </td>
                                <td class="text-align-right">@item.Symbol</td>
                                <td class="delete-cell">
                                    <form method="post" asp-page-handler="MoveStockUp">
                                        <input type="hidden" name="symbol" value="@item.Symbol" />
                                        <button type="submit" class="icon-button-move" title="Subir" @(stockRow == 0 ? "disabled" : "")>▲</button>
                                    </form>
                                    <form method="post" asp-page-handler="MoveStockDown">
                                        <input type="hidden" name="symbol" value="@item.Symbol" />
                                        <button type="submit" class="icon-button-move" title="Bajar" @(stockRow == Model.Stocks.Count - 1 ? "disabled" : "")>▼</button>
                                    </form>
                                    <form method="post" asp-page-handler="DeleteStock" onsubmit="return confirm('¿Eliminar esta acción?');">
                                        <input type="hidden" name="symbol" value="@item.Symbol" />
                                        <button type="submit" class="icon-button-delete" title="Eliminar">✕</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <dialog id="add-stock-dialog" class="add-entry-dialog">
        <form method="post" asp-page-handler="AddStock">
            <h3>Añadir acción</h3>
            <label>
                Índice
                <select id="add-stock-market" name="market" required>
                    <option value="" selected disabled>Selecciona un índice</option>
                    <option value="IBEX35">IBEX-35</option>
                    <option value="CAC40">CAC 40</option>
                    <option value="DAX">DAX</option>
                    <option value="EUROSTOXX50">EURO STOXX 50</option>
                    <option value="DOWJONES">DOW JONES</option>
                    <option value="NASDAQ">NASDAQ-100</option>
                    <option value="SP500">S&amp;P 500</option>
                    <option value="NIKKEI225">NIKKEI 225</option>
                    <option value="HANGSENG">HANG SENG</option>
                </select>
            </label>
            <label>
                Acción
                <select id="add-stock-name" name="name" required disabled>
                    <option value="" selected disabled>Selecciona primero un índice</option>
                </select>
            </label>
            <p class="dialog-hint">El símbolo se busca automáticamente a partir del nombre, priorizando el índice seleccionado.</p>
            <div class="dialog-actions">
                <button type="submit" formmethod="dialog" formnovalidate class="mini-button mini-button-secondary">Cancelar</button>
                <button type="submit" class="mini-button" id="add-stock-submit" disabled>Añadir</button>
            </div>
        </form>
    </dialog>

    <div class="market-panel mt-4 market-panel-watchlist">
        <div class="panel-head panel-head-row">
            <span>ETF <span class="panel-head-subtitle">(Control de cotizaciones)</span></span>
            <button type="button" class="mini-button" data-dialog-target="add-etf-control-dialog">+ Añadir ETF</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.EtfControlError))
        {
            <div class="form-error-banner">@Model.EtfControlError</div>
        }
        <div class="table-wrap">
            <table class="market-table market-table-compact market-table-grid" style="table-layout: fixed;">
                <thead>
                    <tr>
                        <th style="width: 180px;">Nombre</th>
                        <th class="text-align-right" style="width: 70px;">Cambio</th>
                        <th class="text-align-right notranslate" translate="no" style="width: 90px;">COTIZACIÓN ACTUAL</th>
                        <th class="text-align-right" style="width: 90px;">Apertura</th>
                        <th class="text-align-right" style="width: 90px;">CIERRE<br />(Anterior)</th>
                        <th class="text-align-right" style="width: 100px;">Volumen</th>
                        <th class="text-align-right" style="width: 110px;">Actualizado</th>
                        <th class="isin-print-hide text-align-right" style="width: 90px;">ISIN</th>
                        <th style="width: 96px;"></th>
                    </tr>
                </thead>
                <tbody id="tbody-etfs-control">
                    @if (Model.EtfsControl.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="empty-state-cell">No hay ETF añadidos. Usa "+ Añadir ETF" para empezar.</td>
                        </tr>
                    }
                    else
                    {
                        @for (var etfControlRow = 0; etfControlRow < Model.EtfsControl.Count; etfControlRow++)
                        {
                            var item = Model.EtfsControl[etfControlRow];
                            <tr>
                                <td class="name-cell">
                                    <span class="name-with-flag">
                                        <img class="flag-badge" src="@item.FlagUrl" alt="@item.CountryCode" title="@item.CountryCode" />
                                        <a class="name-link" href="/Historico?symbol=@item.Symbol&name=@item.Name&countryCode=@item.CountryCode">@item.Name</a>
                                    </span>
                                </td>
                                <td class="@item.TrendCssClass">@item.DisplayPercent</td>
                                <td class="price-cell price-cell-quote">@item.DisplayPrice @item.CurrencySymbol</td>
