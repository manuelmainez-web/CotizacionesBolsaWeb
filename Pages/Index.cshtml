@section Scripts {
    <script>
        (function () {
            document.addEventListener('click', function (event) {
                var button = event.target && event.target.closest ? event.target.closest('.excel-tx-add-button') : null;
                if (!button) {
                    return;
                }

                var dialog = document.getElementById('add-excel-tx-dialog');
                if (!dialog) {
                    return;
                }

                var type = button.getAttribute('data-type');
                var now = new Date();
                var today = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');

                document.getElementById('add-excel-tx-title').textContent = 'Incluir ' + (type === 'purchase' ? 'compra' : 'venta');
                document.getElementById('add-excel-tx-titulo').value = button.getAttribute('data-titulo') || '';
                document.getElementById('add-excel-tx-tipo').value = type === 'purchase' ? 'COMPRA' : 'VENTA';
                document.getElementById('add-excel-tx-fecha').value = today;
                dialog.querySelectorAll('input[name="numeroTitulos"], input[name="importeTotal"]').forEach(function (input) {
                    input.value = '';
                });

                if (typeof dialog.showModal === 'function') {
                    dialog.showModal();
                } else {
                    dialog.setAttribute('open', 'open');
                }
            });
        })();
    </script>
    <script>
        (function () {
            function normalizeMoneyValue(value) {
                var source = String(value ?? '').trim();
                if (!source) {
                    return '0';
                }

                source = source.replace(/\u00A0/g, '').replace(/€/g, '').replace(/\s/g, '');
                if (!source) {
                    return '0';
                }

                var sanitized = source.replace(/[^0-9,.-]/g, '');
                if (!sanitized || sanitized === '-' || sanitized === '.' || sanitized === ',') {
                    return '0';
                }

                if (sanitized.indexOf(',') !== -1 && sanitized.indexOf('.') !== -1) {
                    var lastComma = sanitized.lastIndexOf(',');
                    var lastDot = sanitized.lastIndexOf('.');
                    if (lastComma > lastDot) {
                        sanitized = sanitized.replace(/\./g, '').replace(',', '.');
                    } else {
                        sanitized = sanitized.replace(/,/g, '');
                    }
                } else if (sanitized.indexOf(',') !== -1) {
                    sanitized = sanitized.replace(/\./g, '').replace(',', '.');
                }

                return sanitized;
            }

            function formatSpanishNumber(value, decimalPlaces) {
                var numberValue = Number(normalizeMoneyValue(value));
                if (!Number.isFinite(numberValue)) {
                    return '0';
                }

                var decimals = typeof decimalPlaces === 'number' ? decimalPlaces : 0;
                var fixed = numberValue.toFixed(decimals);
                var parts = fixed.split('.');
                var integerPart = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                var decimalPart = parts.length > 1 ? ',' + parts[1] : '';
                return integerPart + decimalPart;
            }

            function formatCurrency(value) {
                return formatSpanishNumber(value, 2) + ' €';
            }

            function formatDate(value) {
                var date = new Date(value);
                if (Number.isNaN(date.getTime())) {
                    return value;
                }
                return date.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });
            }

            function normalizeDecimalInputValue(value) {
                if (value === null || value === undefined) {
                    return '';
                }

                var source = String(value).replace(/\u00A0/g, '').trim();
                if (!source) {
                    return '';
                }

                var cleaned = source.replace(/[^\d,.-]/g, '');
                if (!cleaned || cleaned === '-' || cleaned === '.' || cleaned === ',') {
                    return '';
                }

                var numberOfCommas = (cleaned.match(/,/g) || []).length;
                var numberOfDots = (cleaned.match(/\./g) || []).length;

                if (numberOfCommas === 0 && numberOfDots > 0) {
                    var lastDotIndex = cleaned.lastIndexOf('.');
                    var fractionPart = cleaned.substring(lastDotIndex + 1);
                    if (fractionPart.length <= 2) {
                        return cleaned.substring(0, lastDotIndex) + ',' + fractionPart;
                    }

                    return cleaned.replace(/\./g, '');
                }

                if (numberOfCommas > 0 && numberOfDots === 0) {
                    var lastCommaIndex = cleaned.lastIndexOf(',');
                    var fractionPartComma = cleaned.substring(lastCommaIndex + 1);
                    if (fractionPartComma.length <= 2) {
                        return cleaned;
                    }

                    return cleaned.replace(/,/g, '');
                }

                if (numberOfCommas > 0 && numberOfDots > 0) {
                    var lastCommaIndex2 = cleaned.lastIndexOf(',');
                    var lastDotIndex2 = cleaned.lastIndexOf('.');
                    if (lastCommaIndex2 > lastDotIndex2) {
                        return cleaned.replace(/\./g, '').replace(',', '.');
                    }

                    return cleaned.replace(/,/g, '');
                }

                return cleaned;
            }

            function normalizeDecimalInputForSubmit(input) {
                if (!input || !input.value) {
                    return;
                }

                if (input.type === 'text' && input.getAttribute('inputmode') === 'decimal') {
                    input.value = normalizeDecimalInputValue(input.value);
                }
            }

            function formatDecimalInput(value) {
                var parsed = parseDecimalLocale(value);
                if (!Number.isFinite(parsed)) {
                    return '0,00';
                }
                return parsed.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function parseDecimalLocale(value) {
                var source = String(value ?? '0').trim();
                if (!source) {
                    return 0;
                }

                var sanitized = source
                    .replace(/€/g, '')
                    .replace(/\s/g, '')
                    .replace(/[^\d,.-]/g, '');

                if (!sanitized || sanitized === '-' || sanitized === '.' || sanitized === ',') {
                    return 0;
                }

                var lastComma = sanitized.lastIndexOf(',');
                var lastDot = sanitized.lastIndexOf('.');
                var normalized;

                if (lastComma !== -1 && lastDot !== -1) {
                    normalized = lastComma > lastDot
                        ? sanitized.replace(/\./g, '').replace(',', '.')
                        : sanitized.replace(/,/g, '');
                } else if (lastComma !== -1) {
                    var fractionLength = sanitized.length - lastComma - 1;
                    normalized = fractionLength <= 2
                        ? sanitized.replace(',', '.')
                        : sanitized.replace(/,/g, '');
                } else {
                    var dotParts = sanitized.split('.');
                    if (dotParts.length > 2) {
                        normalized = dotParts.slice(0, -1).join('') + '.' + dotParts[dotParts.length - 1];
                    } else {
                        normalized = sanitized;
                    }
                }

                var parsed = Number(normalized);
                return Number.isFinite(parsed) ? parsed : 0;
            }

            function parseMoney(value) {
                if (typeof value === 'number' && Number.isFinite(value)) {
                    return value;
                }

                var normalized = normalizeMoneyValue(value);
                var parsed = Number(normalized);
                return Number.isFinite(parsed) ? parsed : 0;
            }

            function formatNumber(value) {
                var numericValue = Number(value || 0);
                if (!Number.isFinite(numericValue)) {
                    return '0';
                }

                var formatted = numericValue.toFixed(6).replace(/\.?0+$/, '');
                var parts = formatted.split('.');
                parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                return parts.join(',');
            }

            function setupDecimalTextInput(input) {
                if (!input) {
                    return;
                }

                input.setAttribute('inputmode', 'decimal');
                input.setAttribute('lang', 'es-ES');

                input.addEventListener('keydown', function (event) {
                    if (event.key === ',' || event.key === '.') {
                        event.preventDefault();
                        if (/[.,]/.test(input.value)) {
                            return;
                        }
                        var separator = ',';
                        var start = input.selectionStart ?? input.value.length;
                        var end = input.selectionEnd ?? input.value.length;
                        var nextValue = input.value.slice(0, start) + separator + input.value.slice(end);
                        input.value = nextValue;
                        var caret = start + 1;
                        if (typeof input.setSelectionRange === 'function') {
                            requestAnimationFrame(function () {
                                input.setSelectionRange(caret, caret);
                            });
                        }
                    }
                });

                input.addEventListener('input', function () {
                    var normalized = normalizeDecimalInputValue(input.value);
                    if (normalized !== input.value) {
                        input.value = normalized;
                    }
                });

                input.addEventListener('blur', function () {
                    if (input.id === 'transaction-importe-field') {
                        input.value = formatDecimalInput(input.value);
                    }
                });
            }

            document.addEventListener('DOMContentLoaded', function () {
                document.querySelectorAll('input[type="number"], input[type="text"][inputmode="decimal"]').forEach(function (input) {
                    input.setAttribute('inputmode', 'decimal');
                    input.setAttribute('lang', 'es-ES');

                    input.addEventListener('keydown', function (event) {
                        if (event.key === ',' || event.key === '.') {
                            event.preventDefault();
                            if (/[.,]/.test(input.value)) {
                                return;
                            }
                            var separator = ',';
                            var start = input.selectionStart ?? input.value.length;
                            var end = input.selectionEnd ?? input.value.length;
                            var nextValue = input.value.slice(0, start) + separator + input.value.slice(end);
                            input.value = nextValue;
                            var caret = start + 1;
                            if (typeof input.setSelectionRange === 'function') {
                                requestAnimationFrame(function () {
                                    input.setSelectionRange(caret, caret);
                                });
                            }
                        }
                    });

                    input.addEventListener('change', function () {
                        var normalized = normalizeDecimalInputValue(input.value);
                        if (normalized !== input.value) {
                            input.value = normalized;
                        }
                    });
                });

                document.querySelectorAll('form').forEach(function (form) {
                    form.addEventListener('submit', function () {
                        form.querySelectorAll('input[type="text"][inputmode="decimal"]').forEach(function (input) {
                            normalizeDecimalInputForSubmit(input);
                        });
                    });
                });

                ['transaction-quantity-field', 'transaction-importe-field'].forEach(function (fieldId) {
                    setupDecimalTextInput(document.getElementById(fieldId));
                });
            });

            function openDialogSafely(dialog) {
                if (typeof dialog.showModal === 'function') {
                    dialog.showModal();
                    return;
                }

                dialog.setAttribute('open', 'open');
                dialog.style.display = 'block';
                dialog.style.position = 'fixed';
                dialog.style.inset = '0';
                dialog.style.zIndex = '1000';
                dialog.style.margin = 'auto';
            }

            function closeDialogSafely(dialog) {
                if (typeof dialog.close === 'function' && dialog.hasAttribute('open')) {
                    dialog.close();
                }

                dialog.removeAttribute('open');
                dialog.style.display = '';
            }

            function todayLocalIso() {
                var now = new Date();
                var month = String(now.getMonth() + 1).padStart(2, '0');
                var day = String(now.getDate()).padStart(2, '0');
                return now.getFullYear() + '-' + month + '-' + day;
            }

            function openTransactionDialog(card, editButton) {
                var dialog = document.getElementById('transaction-entry-dialog');
                if (!dialog || !card) {
                    return;
                }

                var type = card.getAttribute('data-transaction-type');
                var editing = !!editButton;
                var titleField = document.getElementById('transaction-title-field');
                var title = editing ? (editButton.getAttribute('data-titulo') || '') : '';

                document.getElementById('transaction-type-field').value = type;
                document.getElementById('transaction-broker-field').value = card.getAttribute('data-broker-code');
                document.getElementById('transaction-row-id-field').value = editing ? (editButton.getAttribute('data-id') || '') : '';
                document.getElementById('transaction-dialog-title').textContent = (editing ? 'Editar ' : 'Añadir ') + (type === 'purchase' ? 'compra' : 'venta');
                document.getElementById('transaction-operation-field').value = type === 'purchase' ? 'COMPRA' : 'VENTA';

                if (title) {
                    var exists = Array.prototype.some.call(titleField.options, function (option) {
                        return option.value === title;
                    });
                    if (!exists) {
                        var extraOption = document.createElement('option');
                        extraOption.value = title;
                        extraOption.textContent = title;
                        titleField.appendChild(extraOption);
                    }
                }
                titleField.value = title;

                document.getElementById('transaction-quantity-field').value = editing ? (editButton.getAttribute('data-numero') || '') : '';
                document.getElementById('transaction-importe-field').value = editing ? (editButton.getAttribute('data-importe') || '') : '';
                document.getElementById('transaction-fecha-field').value = editing ? (editButton.getAttribute('data-fecha') || todayLocalIso()) : todayLocalIso();

                openDialogSafely(dialog);
            }

            document.addEventListener('click', function (event) {
                var target = event.target;
                if (!target || !target.closest) {
                    return;
                }

                var addButton = target.closest('.transaction-add-button');
                if (addButton) {
                    openTransactionDialog(addButton.closest('.transaction-broker-card'), null);
                    return;
                }

                var editButton = target.closest('.transaction-edit-row');
                if (editButton) {
                    openTransactionDialog(editButton.closest('.transaction-broker-card'), editButton);
                    return;
                }

                if (target.closest('#transaction-cancel-button')) {
                    closeDialogSafely(document.getElementById('transaction-entry-dialog'));
                }
            });

            // El formulario de compra-venta envia los numeros tal cual (coma decimal); el servidor los interpreta.
            document.addEventListener('submit', function (event) {
                if (event.target && event.target.id === 'transaction-entry-form') {
                    event.stopPropagation();
                }
            }, true);
        })();
    </script>
    <script>
        (function () {
            var classificationSelect = document.getElementById('commodity-classification-select');
            var symbolSelect = document.getElementById('commodity-symbol-select');

            function filtrarMateriasPrimas() {
                if (!classificationSelect || !symbolSelect) {
                    return;
                }
                var seleccionada = classificationSelect.value;
                var primeraVisible = null;
                Array.prototype.forEach.call(symbolSelect.options, function (opcion) {
                    var coincide = opcion.getAttribute('data-classification') === seleccionada;
                    opcion.hidden = !coincide;
                    opcion.disabled = !coincide;
                    if (coincide && !primeraVisible) {
                        primeraVisible = opcion;
                    }
                });
                var actual = symbolSelect.options[symbolSelect.selectedIndex];
                if (!actual || actual.disabled) {
                    if (primeraVisible) {
                        symbolSelect.value = primeraVisible.value;
                    }
                }
            }

            if (classificationSelect && symbolSelect) {
                classificationSelect.addEventListener('change', filtrarMateriasPrimas);
                filtrarMateriasPrimas();
            }
        })();
    </script>
    <script>
        (function () {
            var refreshIntervalMs = 15000;
            var idsAActualizar = [
                'summary-strip-general',
                'summary-strip',
                'summary-strip-ing',
                'summary-strip-tr',
                'tbody-indices',
                'tbody-stocks',
                'tbody-etfs-control',
                'tbody-commodities',
                'tbody-etfs',
                'tbody-funds',
                'tbody-pensionplans',
                'tbody-checkingaccounts-ing',
                'tbody-checkingaccounts-tr',
                'tbody-cash',
                'tbody-portfolio-stocks',
                'transaction-broker-grid-tr'
            ];

            function actualizarDatos() {
                var hayDialogoAbierto = document.querySelector('dialog[open]') !== null;
                if (hayDialogoAbierto) {
                    return Promise.resolve();
                }

                return fetch(window.location.href, { cache: 'no-store' })
                    .then(function (respuesta) { return respuesta.text(); })
                    .then(function (html) {
                        var parser = new DOMParser();
                        var docNuevo = parser.parseFromString(html, 'text/html');

                        idsAActualizar.forEach(function (id) {
                            var actual = document.getElementById(id);
                            var nuevo = docNuevo.getElementById(id);
                            if (actual && nuevo) {
                                var panelRef = actual.querySelector('#rendimiento-ref-ing');
                                var panelRefNuevo = nuevo.querySelector('#rendimiento-ref-ing');

                                if (panelRef && panelRefNuevo) {
                                    // El panel "Importe de referencia" conserva sus cajas de texto (y el foco):
                                    // solo se renuevan las demás cajas del resumen y el importe total.
                                    Array.prototype.slice.call(actual.children).forEach(function (hijo) {
                                        if (hijo !== panelRef) {
                                            actual.removeChild(hijo);
                                        }
                                    });
                                    Array.prototype.slice.call(nuevo.children).forEach(function (hijo) {
                                        if (hijo.id !== 'rendimiento-ref-ing') {
                                            actual.insertBefore(document.importNode(hijo, true), panelRef);
                                        }
                                    });
                                    panelRef.setAttribute('data-total', panelRefNuevo.getAttribute('data-total'));
                                    var totalActual = panelRef.querySelector('.rendimiento-ref-total');
                                    var totalNuevo = panelRefNuevo.querySelector('.rendimiento-ref-total');
                                    if (totalActual && totalNuevo) {
                                        totalActual.textContent = totalNuevo.textContent;
                                    }
                                    panelRef.dispatchEvent(new CustomEvent('rendimiento-ref-actualizar'));
                                } else {
                                    actual.innerHTML = nuevo.innerHTML;
                                }
                            }
                        });

                        if (window.paginarTablasCompraVenta) {
                            window.paginarTablasCompraVenta();
                        }
                    })
                    .catch(function () {
                        // Si falla la petición (red, servidor dormido, etc.) simplemente se reintenta en el siguiente ciclo.
                    });
            }

            setInterval(actualizarDatos, refreshIntervalMs);
            window.refreshPageData = actualizarDatos;
        })();
    </script>
    <script src="/js/transaction-summary.js"></script>
}
