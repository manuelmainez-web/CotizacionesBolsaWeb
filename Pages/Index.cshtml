    @{
        var trab = Model.Trabajo;
        var trabState = Model.TrabajoState;
        var resumen = Model.ResumenIrpf;
        var resumenClass = resumen.ToPay > 0 ? "hacienda-loss" : (resumen.ToPay < 0 ? "hacienda-gain" : "");
        string Num(decimal v) => v.ToString("#,##0.##", esCulture);
        Microsoft.AspNetCore.Html.IHtmlContent OvCell(string name, decimal value, decimal? manual)
        {
            var cls = manual.HasValue ? "hacienda-casilla-input hacienda-casilla-overridden" : "hacienda-casilla-input";
            var title = manual.HasValue
                ? "Valor modificado a mano; vacía el campo para volver al cálculo automático"
                : "Calculado automáticamente; puedes modificarlo";
            var shown = Num(value);
            return Html.Raw("<td class=\"text-align-right\"><input type=\"text\" class=\"" + cls + "\" name=\"" + name
                + "\" inputmode=\"decimal\" value=\"" + shown + "\" title=\"" + title + "\" /><input type=\"hidden\" name=\""
                + name + "Shown\" value=\"" + shown + "\" /></td>");
        }
    }
    <div class="market-panel hacienda-panel mt-4">
        <div class="panel-head panel-head-row">
            <span>
                <button type="button" class="btn-toggle-summary table-toggle-button toggle-left" data-toggle-target="trabajo-panel-body" data-toggle-name="hacienda-trabajo" title="Mostrar/ocultar" aria-label="Mostrar rendimiento del trabajo" aria-expanded="false"></button>
                <img class="transaction-broker-logo panel-header-logo" src="/images/brokers/aeat.png" style="border-radius: 6px; background: #fff;" alt="Agencia Tributaria" title="Agencia Tributaria" />
                Rendimiento del trabajo <span class="panel-head-subtitle">(IRPF · base general · ejercicio @hac.Year)</span>
            </span>
            <div class="panel-head-actions">
                <span class="transaction-total-summary">Rendimiento neto reducido: <strong>@trab.NetIncome.ToString(eurPlain, esCulture)</strong></span>
            </div>
        </div>
        <p class="panel-help-text">Rellena las casillas de la declaración (modelo 100) según tu certificado de retenciones; el resto de filas se calculan solas con las fórmulas de Renta WEB. Los gastos generales (2.000 €) y la reducción por obtención de rendimientos del trabajo se aplican automáticamente. Las filas calculadas (Retribuciones en especie, Total ingresos, Rendimientos netos, Otros gastos deducibles, reducción…) también se pueden modificar: escribe el importe que quieras y se usará en el resto de cálculos (se marca en naranja); si vacías el campo, vuelve el cálculo automático. Las filas sin número de casilla (—) son desgloses propios de esta página.</p>
        <div id="trabajo-panel-body" class="hacienda-panel-body transaction-broker-grid is-collapsed">
            <div class="transaction-broker-card">
                <div class="transaction-broker-header"><div class="transaction-broker-name"><span>Rendimientos del trabajo · Contribuyente que obtiene los rendimientos: DECLARANTE</span></div></div>
                <form method="post" asp-page-handler="SaveTrabajo">
                    <div class="table-wrap">
                        <table class="market-table market-table-grid transaction-table">
                            <thead>
                                <tr>
                                    <th>Casilla</th>
                                    <th>Concepto</th>
                                    <th class="text-align-right">Importe (€)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>0003</td>
                                    <td>Retribuciones dinerarias</td>
                                    <td class="text-align-right"><input type="text" class="hacienda-casilla-input" name="retribucionesDinerarias" inputmode="decimal" value="@Num(trabState.RetribucionesDinerarias)" /></td>
                                </tr>
                                <tr>
                                    <td>0004</td>
                                    <td>Valoración retribución en especie</td>
                                    <td class="text-align-right"><input type="text" class="hacienda-casilla-input" name="valoracionEspecie" inputmode="decimal" value="@Num(trabState.ValoracionEspecie)" /></td>
                                </tr>
                                <tr>
                                    <td>0005</td>
                                    <td>Ingresos a cuenta de retribución en especie</td>
                                    <td class="text-align-right"><input type="text" class="hacienda-casilla-input" name="ingresosCuentaEspecie" inputmode="decimal" value="@Num(trabState.IngresosCuentaEspecie)" /></td>
                                </tr>
                                <tr>
                                    <td>0006</td>
                                    <td>Ingresos a cuenta repercutidos de retribución en especie</td>
                                    <td class="text-align-right"><input type="text" class="hacienda-casilla-input" name="ingresosCuentaRepercutidos" inputmode="decimal" value="@Num(trabState.IngresosCuentaRepercutidos)" /></td>
                                </tr>
                                <tr class="transaction-row-current-year">
                                    <td>0007</td>
                                    <td><strong>Retribuciones en especie</strong> [(4)+(5)-(6)]</td>
                                    @OvCell("ovRetribucionesEspecie", trab.InKindIncome, trabState.OvRetribucionesEspecie)
                                </tr>
                                <tr>
                                    <td>0008</td>
                                    <td>Contribuciones empresariales a Planes de Pensiones y Mutualidades de Previsión Social</td>
                                    <td class="text-align-right"><input type="text" class="hacienda-casilla-input" name="contribucionesPlanes" inputmode="decimal" value="@Num(trabState.ContribucionesPlanes)" /></td>
                                </tr>
                                <tr>
                                    <td>0011</td>
                                    <td>Reducciones (artículo 18.2 y 3, y disposiciones transitorias 11ª, 12ª y 25ª de la Ley)</td>
                                    <td class="text-align-right"><input type="text" class="hacienda-casilla-input" name="reducciones" inputmode="decimal" value="@Num(trabState.Reducciones)" /></td>
                                </tr>
                                <tr class="transaction-row-current-year">
                                    <td>0012</td>
                                    <td><strong>Total ingresos íntegros computables</strong> [(03)+(07)+(08)+(24)+(09)+(10)-(11)-(58)]</td>
                                    @OvCell("ovTotalIngresos", trab.GrossIncome, trabState.OvTotalIngresos)
                                </tr>
                                <tr>
                                    <td>0013</td>
                                    <td>Cotizac. Seguridad Social, Mutualidad Funcionarios, detracciones derechos pasivos y Coleg. Huérfanos</td>
                                    <td class="text-align-right"><input type="text" class="hacienda-casilla-input" name="cotizacionesSS" inputmode="decimal" value="@Num(trabState.CotizacionesSS)" /></td>
                                </tr>
                                <tr class="transaction-row-current-year">
                                    <td>0017</td>
                                    <td><strong>Rendimiento neto previo</strong> [(12)-(13)-(14)-(15)-(16)]</td>
                                    @OvCell("ovNetoPrevio", trab.PreviousNet, trabState.OvNetoPrevio)
                                </tr>
                                <tr class="transaction-row-current-year">
                                    <td>0018</td>
                                    <td><strong>Suma de rendimientos netos previos</strong></td>
                                    @OvCell("ovSumaNetosPrevios", trab.PreviousNetSum, trabState.OvSumaNetosPrevios)
                                </tr>
                                <tr>
                                    <td>0019</td>
                                    <td>Otros gastos deducibles: gastos generales (importe fijo)</td>
                                    @OvCell("ovOtrosGastos", trab.FixedExpenses, trabState.OvOtrosGastos)
                                </tr>
                                <tr class="transaction-row-current-year">
                                    <td>0022</td>
                                    <td><strong>Rendimiento neto</strong> [(18)-(19)-(20)-(21)]</td>
                                    @OvCell("ovRendimientoNeto", trab.NetBeforeReduction, trabState.OvRendimientoNeto)
                                </tr>
                                <tr>
                                    <td>0023</td>
                                    <td>• Reducción por obtención de rendimientos del trabajo (art. 20 LIRPF, automática)</td>
                                    @OvCell("ovReduccionTrabajo", trab.Reduction, trabState.OvReduccionTrabajo)
                                </tr>
                                <tr class="transaction-row-current-year">
                                    <td>0025</td>
                                    <td><strong>Rendimiento neto reducido</strong> [(22)-(23)]</td>
                                    @OvCell("ovNetoReducido", trab.NetIncome, trabState.OvNetoReducido)
                                </tr>
                                <tr>
                                    <td>0596</td>
                                    <td>Retenciones del trabajo (pagos a cuenta)</td>
                                    <td class="text-align-right"><input type="text" class="hacienda-casilla-input" name="retenciones" inputmode="decimal" value="@Num(trabState.Retenciones)" /></td>
                                </tr>
                                <tr>
                                    <td>0519</td>
                                    <td>Mínimo personal y familiar para calcular el gravamen estatal (5.550 € general; súmale descendientes, ascendientes, etc.)</td>
                                    <td class="text-align-right"><input type="text" class="hacienda-casilla-input" name="minimoPersonal" inputmode="decimal" value="@Num(trabState.MinimoPersonal)" /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="hacienda-inputs-form">
                        <button type="submit" class="mini-button">Guardar y recalcular</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @{
        var cap = Model.CapitalState;
